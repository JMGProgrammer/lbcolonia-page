---
// Afiche oficial GameDay / Próxima Fecha con jugador real de la LBC
import Escudo from './Escudo.astro';
import type { PartidoVista } from '../lib/data';
import { fechaCorta, horaCorta, rondaLabel } from '../lib/fmt';

interface Props {
  ronda: string;
  partidos: PartidoVista[];
  torneoId?: string;
}

const { ronda, partidos, torneoId } = Astro.props;
const primerPartido = partidos[0];
const fechaIso = primerPartido?.fecha_hora ?? '';
const estelar = partidos[partidos.length - 1] ?? primerPartido;
---

<div class="card-vigor relative overflow-hidden p-6 sm:p-7 flex flex-col justify-between border-t-2 border-t-gold-400">
  <!-- Fondo con jugador en acción recortado y gradiente deportivo -->
  <div class="pointer-events-none absolute -right-6 bottom-0 top-10 w-64 sm:w-72 overflow-hidden opacity-35 sm:opacity-45 mix-blend-luminosity">
    <img
      src="/images/jugadores/jugador-plaza-verde.webp"
      alt="Jugador de la Liga de Básquetbol de Colonia"
      class="h-full w-full object-contain object-bottom filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)]"
      loading="lazy"
    />
  </div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-navy-950 via-navy-950/90 to-transparent"></div>

  <!-- Contenido principal -->
  <div class="relative z-10 space-y-5">
    <!-- Encabezado con badge y fecha -->
    <div class="flex items-center justify-between border-b border-navy-700/60 pb-3">
      <div class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 bg-orange-500 animate-pulse"></span>
        <span class="text-xs font-black uppercase tracking-widest text-gold-400">
          Matchday Oficial
        </span>
      </div>
      <span class="text-xs font-bold uppercase tracking-wider text-paper/70">
        {rondaLabel(ronda)}
      </span>
    </div>

    <!-- Título de la fecha -->
    <div>
      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-paper">
        {rondaLabel(ronda)}
      </h2>
      <p class="mt-0.5 text-xs font-bold uppercase tracking-wider text-orange-400">
        {fechaIso ? fechaCorta(fechaIso) : ''}
      </p>
    </div>

    <!-- Partido estelar con escudos grandes enfrentados -->
    {estelar && (
      <div class="rounded-none bg-navy-950/80 p-4 border border-navy-700/80 backdrop-blur-sm shadow-xl">
        <span class="block text-[0.68rem] font-black uppercase tracking-widest text-paper/60 mb-2.5">
          Partido Destacado de la Fecha
        </span>
        <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 text-center">
          <!-- Local -->
          <div class="flex flex-col items-center gap-1 min-w-0">
            <Escudo club={estelar.local?.clubes} tam="lg" />
            <span class="text-xs sm:text-sm font-black text-paper leading-tight">
              {estelar.local?.clubes.nombre}
            </span>
          </div>

          <!-- Centro VS / Hora -->
          <div class="flex flex-col items-center justify-center px-1">
            <span class="num text-base sm:text-xl font-black text-orange-400">
              {horaCorta(estelar.fecha_hora)}
            </span>
            <span class="text-[0.62rem] font-black uppercase tracking-widest text-gold-400 px-1.5 py-0.5 bg-navy-900 border border-gold-400/30">
              VS
            </span>
          </div>

          <!-- Visitante -->
          <div class="flex flex-col items-center gap-1 min-w-0">
            <Escudo club={estelar.visitante?.clubes} tam="lg" />
            <span class="text-xs sm:text-sm font-black text-paper leading-tight">
              {estelar.visitante?.clubes.nombre}
            </span>
          </div>
        </div>
      </div>
    )}

    <!-- Cartelera completa de la fecha -->
    <div class="space-y-2 pt-1">
      <span class="block text-xs font-black uppercase tracking-wider text-paper/80">
        Cartelera de la jornada:
      </span>
      <div class="space-y-1.5">
        {partidos.map((p) => (
          <div class="flex items-center justify-between text-xs font-semibold py-1.5 px-3 bg-navy-900/60 border-l-2 border-orange-500 text-paper">
            <span class="font-bold text-paper">
              {p.local?.clubes.nombre} vs {p.visitante?.clubes.nombre}
            </span>
            <span class="num font-black text-orange-400 text-sm">
              {horaCorta(p.fecha_hora)}
            </span>
          </div>
        ))}
      </div>
      <p class="text-[0.72rem] font-medium text-paper/60 pt-1">
        📍 {primerPartido?.sede ?? 'Gimnasios y sedes oficiales a confirmar'}
      </p>
    </div>
  </div>

  <!-- Botón de acción recto -->
  <div class="relative z-10 pt-5 mt-4 border-t border-navy-700/60">
    <a
      href={`/fixture?torneo=${torneoId ?? ''}&ronda=${ronda}`}
      class="block w-full text-center bg-orange-500 hover:bg-orange-400 text-ink text-xs sm:text-sm font-black uppercase tracking-wider py-3 transition-colors shadow-lg active:scale-[0.99] no-underline"
    >
      Ver fixture completo y detalles &rarr;
    </a>
  </div>
</div>
