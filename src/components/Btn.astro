---
// Botón de acción: naranja con texto tinta (Docs/11: el naranja es EL color de acción).
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a
  href={href}
  class="inline-block rounded-full border border-orange-500 bg-orange-500 px-6 py-2.5 text-[0.85rem] font-black uppercase tracking-widest text-ink transition-all duration-200 hover:bg-orange-600 hover:text-paper hover:shadow-[0_4px_16px_rgba(238,107,31,0.35)] active:scale-[.98]"
>
  <slot />
</a>
