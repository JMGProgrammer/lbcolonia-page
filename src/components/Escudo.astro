---
// Escudo de club: prioridad escudo local optimizado, luego CDN de Storage, luego iniciales.
import { resolverEscudo } from '../lib/escudos';
interface Props {
  club?: { nombre: string; slug: string; escudo_url: string | null; color1: string | null; color2: string | null };
  tam?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
}
const { club, tam = 'md' } = Astro.props;

const medidas: Record<string, string> = {
  xs: 'h-7 w-7',
  sm: 'h-9 w-9',
  md: 'h-12 w-12',
  lg: 'h-16 w-16',
  xl: 'h-28 w-28 sm:h-36 sm:w-36',
  '2xl': 'h-36 w-36 sm:h-44 sm:w-44',
};
const clase = medidas[tam] ?? medidas.md;

const url = resolverEscudo(club);

const iniciales =
  (club?.nombre ?? '')
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .map((p) => p[0]!.toUpperCase())
    .join('')
    .slice(0, 3) || '·';

const fundido = club?.color1 ?? '#1c2b56';
const texto = club?.color2 ?? '#f4f1ea';
---

{
  url ? (
    <span class={`image-skeleton relative inline-flex shrink-0 items-center justify-center ${clase}`} data-image-shell>
      <img
        src={url}
        alt={`Escudo de ${club?.nombre ?? 'club'}`}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-contain drop-shadow-[0_2px_6px_rgba(0,0,0,0.5)]"
        data-skeleton-image
      />
      <span
        class="hidden h-full w-full items-center justify-center rounded-lg font-black text-xs shadow-sm"
        style={`background:${fundido};color:${texto};border:1px solid ${texto}30`}
        aria-label={`Escudo no disponible de ${club?.nombre ?? 'club'}`}
        data-image-fallback
      >
        {iniciales}
      </span>
    </span>
  ) : (
    <span
      class={`flex shrink-0 place-items-center justify-center rounded-lg font-black text-xs shadow-sm ${clase}`}
      style={`background:${fundido};color:${texto};border:1px solid ${texto}30`}
      aria-label={`Escudo de ${club?.nombre ?? 'club'}`}
    >
      {iniciales}
    </span>
  )
}
