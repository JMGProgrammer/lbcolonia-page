---
// Ficha oficial de jugador LBC
// Tarjeta con silueta/foto, indicador circular de estado (verde=confirmada / rojo=pendiente)
// y dorsal al costado del nombre del jugador.
import type { FichaRoster } from '../lib/data';

interface Props {
  ficha: FichaRoster;
  categoriaNombre?: string;
}

const { ficha, categoriaNombre } = Astro.props;
const j = ficha.jugadores;
const dorsal = ficha.dorsal != null ? String(ficha.dorsal).padStart(2, '0') : null;
const foto = j?.foto_url || '/images/without-photo.webp';
const estaAceptada = ficha.estado === 'confirmada';

let nacimientoAnio = '';
if (j?.fecha_nacimiento) {
  try {
    nacimientoAnio = new Date(j.fecha_nacimiento).getFullYear().toString();
  } catch {
    // fallback
  }
}
---

<div class="card-vigor group relative flex flex-col overflow-hidden border border-navy-700/80 bg-navy-950/70 p-3 transition-all duration-200 hover:border-orange-500/60 hover:-translate-y-1 hover:shadow-xl">
  <!-- Cabecera de la ficha: categoría e indicador de estado ante la liga (círculo verde o rojo) -->
  <div class="flex items-center justify-between pb-2 border-b border-navy-800/70">
    <span class="text-[0.65rem] font-bold uppercase tracking-wider text-paper/60 truncate">
      {categoriaNombre ?? 'Plantel'}
    </span>
    <div class="flex items-center gap-1.5" title={estaAceptada ? 'Ficha habilitada y aceptada por la liga' : 'Ficha pendiente de validación por secretaría'}>
      <span class={`inline-block h-2.5 w-2.5 rounded-full ${estaAceptada ? 'bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]' : 'bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.8)]'}`}></span>
      <span class={`text-[0.62rem] font-black uppercase tracking-wider ${estaAceptada ? 'text-emerald-400' : 'text-red-400'}`}>
        {estaAceptada ? 'Aceptada' : 'Pendiente'}
      </span>
    </div>
  </div>

  <!-- Foto / Silueta del jugador limpia (sin números superpuestos) -->
  <div class="relative my-2.5 flex h-36 sm:h-40 w-full items-center justify-center overflow-hidden bg-navy-900/60 border border-navy-800/70">
    <img
      src={foto}
      alt={`Foto de ${j?.nombre_completo ?? 'Jugador'}`}
      loading="lazy"
      class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
  </div>

  <!-- Información del jugador: dorsal al costado del nombre -->
  <div class="flex flex-col gap-1 min-w-0 pt-0.5">
    <div class="flex items-baseline gap-1.5 min-w-0" title={j?.nombre_completo}>
      {dorsal && (
        <span class="num text-sm sm:text-base font-black text-orange-500 group-hover:text-gold-400 transition-colors shrink-0">
          #{dorsal}
        </span>
      )}
      <h4 class="m-0 text-sm font-black leading-snug text-paper group-hover:text-orange-400 transition-colors truncate">
        {j?.nombre_completo ?? 'Jugador'}
      </h4>
    </div>
    <div class="flex items-center justify-between text-[0.68rem] text-paper/60 pt-0.5 border-t border-navy-900">
      <span class="font-medium text-paper/50 uppercase tracking-wider">
        Liga de Colonia
      </span>
      {nacimientoAnio && (
        <span class="num font-bold text-gold-400/90">
          Clase {nacimientoAnio}
        </span>
      )}
    </div>
  </div>
</div>
