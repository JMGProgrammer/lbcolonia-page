---
// Card de noticia para la home/el listado. Portada con transform del CDN si existe.
import type { NoticiaPublica } from '../lib/data';
import { fechaCorta } from '../lib/fmt';

interface Props {
  noticia: NoticiaPublica;
}
const { noticia } = Astro.props;

const fecha = noticia.publicado_at ?? '';
let portada = noticia.portada_url ?? null;
if (portada && portada.includes('/storage/v1/object/') && !portada.includes('?')) {
  portada = `${portada}?width=768&quality=75&format=webp`;
}
const fechaIso = fecha ? new Date(fecha).toISOString().slice(0, 10) : undefined;
---

<article class="flex flex-col overflow-hidden rounded-panel border border-navy-700 bg-navy-800 transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-panel">
  <a href={`/noticias/${noticia.slug}`} class="flex h-full flex-col no-underline">
    <div class="grid aspect-video place-items-center bg-navy-700 text-[0.75rem] uppercase tracking-[0.12em] text-paper-muted">
      {portada ? <img src={portada} alt={`Portada: ${noticia.titulo}`} class="h-full w-full object-cover" loading="lazy" width="768" height="432" /> : 'Noticia de la liga'}
    </div>
    <div class="flex flex-1 flex-col gap-1 p-4">
      <time datetime={fechaIso} class="text-[0.72rem] uppercase tracking-[0.1em] text-gold-400">{fecha ? fechaCorta(fecha) : ''}</time>
      <h3 class="text-[1.02rem] font-extrabold leading-snug">{noticia.titulo}</h3>
      {noticia.bajada && <p class="mt-1 text-[0.85rem] leading-relaxed text-paper-muted">{noticia.bajada}</p>}
    </div>
  </a>
</article>
