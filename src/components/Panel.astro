---
// Panel: bloque navy-800 con radio 14px y franja superior de color (Docs/11 §3).
// Variante acepta el color de la franja; naranja por defecto.
interface Props {
  variante?: 'naranja' | 'rojo' | 'dorado';
}
const { variante = 'naranja' } = Astro.props;
const franja = {
  naranja: 'bg-orange-500',
  rojo: 'bg-red-500',
  dorado: 'bg-gold-400',
}[variante];
---

<section class="card-vigor relative overflow-hidden">
  <span class={`absolute inset-x-0 top-0 h-1.5 ${franja}`} aria-hidden="true"></span>
  <div class="p-6 pt-7">
    <slot />
  </div>
</section>
