---
// Fila compacta de partido para listados (fixture/home/club): agenda o resultado.
// Card enlazada a la ficha solo cuando hay resultado público (finalizado/walkover).
import Escudo from './Escudo.astro';
import type { PartidoVista } from '../lib/data';
import { etiquetaEstado, fechaCorta, horaCorta, rondaLabel } from '../lib/fmt';

interface Props {
  partido: PartidoVista;
}
const { partido } = Astro.props;

const loc = partido.local?.clubes;
const vis = partido.visitante?.clubes;
const esResultado = partido.publicado && (partido.estado === 'finalizado' || partido.estado === 'walkover');
const badge = etiquetaEstado(partido.estado);
const tonoBadge: Record<string, string> = {
  gris: 'bg-navy-700 text-paper',
  naranja: 'bg-orange-500 text-ink',
  rojo: 'bg-red-500 text-paper',
  dorado: 'bg-gold-400 text-ink',
};
const marcador = partido.estado === 'walkover' ? 'W' : `${partido.puntos_local ?? ''}–${partido.puntos_visitante ?? ''}`;

const marco =
  'card-vigor flex min-w-0 flex-col gap-3.5 p-4 sm:p-4.5 transition-all duration-200 sm:flex-row sm:items-center sm:gap-5';
const marcoActiva = `${marco} hover:border-orange-500/50 hover:shadow-xl`;
const aria = `${rondaLabel(partido.ronda)} · ${fechaCorta(partido.fecha_hora)} ${horaCorta(partido.fecha_hora)} · ${loc?.nombre ?? ''} vs ${vis?.nombre ?? ''}`;
---

{
  esResultado ? (
    <a href={`/partidos/${partido.id}`} aria-label={aria} class={marcoActiva}>
      <div class="min-w-[95px] shrink-0 border-b border-navy-700/60 pb-2 sm:border-b-0 sm:border-r sm:pb-0 sm:pr-3">
        <strong class="block text-xs font-black uppercase tracking-wider text-gold-400">{fechaCorta(partido.fecha_hora)}</strong>
        <span class="num text-lg font-black text-paper">{horaCorta(partido.fecha_hora)}</span>
      </div>
      <div class="flex min-w-0 flex-1 flex-col items-start gap-2 sm:flex-row sm:items-center">
        <span class="flex min-w-0 items-center gap-2.5 sm:w-[46%]">
          <Escudo club={loc} tam="sm" />
          <span class={`min-w-0 truncate text-base font-bold ${partido.estado === 'walkover' && partido.local?.id === partido.walkover_ganador_id ? 'text-gold-400' : 'text-paper'}`}>
            {loc?.nombre ?? 'Local'}
          </span>
        </span>
        <span class="hidden px-2 text-base font-black text-orange-500 sm:inline" aria-hidden="true">
          {marcador}
        </span>
        <span class="flex min-w-0 items-center gap-2.5 sm:ml-auto sm:w-[46%] sm:flex-row-reverse sm:text-right">
          <Escudo club={vis} tam="sm" />
          <span class={`min-w-0 truncate text-base font-bold ${partido.estado === 'walkover' && partido.visitante?.id === partido.walkover_ganador_id ? 'text-gold-400' : 'text-paper'}`}>
            {vis?.nombre ?? 'Visitante'}
          </span>
        </span>
      </div>
      <div class="flex min-w-0 items-center justify-between gap-2 sm:flex-col sm:items-end">
        <span class="num text-xl font-black text-orange-500 sm:hidden">{marcador}</span>
        <span class={`rounded-full px-3 py-1 text-xs font-black uppercase tracking-wider shadow-sm ${tonoBadge[badge.tono] ?? ''}`}>{badge.texto}</span>
      </div>
      <div class="w-full border-t border-navy-700/60 pt-2 text-xs font-medium text-paper/75 sm:min-w-0 sm:max-w-[200px] sm:w-auto sm:border-0 sm:pt-0 sm:text-right">
        {partido.sede ?? 'Sede a confirmar'}
      </div>
      {partido.nota_publica && <p class="text-xs font-semibold text-gold-400 sm:min-w-0 sm:max-w-[220px] sm:text-right">{partido.nota_publica}</p>}
    </a>
  ) : (
    <article aria-label={aria} class={marco}>
      <div class="min-w-[95px] shrink-0 border-b border-navy-700/60 pb-2 sm:border-b-0 sm:border-r sm:pb-0 sm:pr-3">
        <strong class="block text-xs font-black uppercase tracking-wider text-gold-400">{fechaCorta(partido.fecha_hora)}</strong>
        <span class="num text-lg font-black text-paper">{horaCorta(partido.fecha_hora)}</span>
      </div>
      <div class="flex min-w-0 flex-1 flex-col items-start gap-2 sm:flex-row sm:items-center">
        <span class="flex min-w-0 items-center gap-2.5 sm:w-[46%]">
          <Escudo club={loc} tam="sm" />
          <span class="min-w-0 truncate text-base font-bold text-paper">{loc?.nombre ?? 'Local'}</span>
        </span>
        <span class="hidden px-2 text-xs font-black uppercase tracking-widest text-paper-muted sm:inline" aria-hidden="true">vs</span>
        <span class="flex min-w-0 items-center gap-2.5 sm:ml-auto sm:w-[46%] sm:flex-row-reverse sm:text-right">
          <Escudo club={vis} tam="sm" />
          <span class="min-w-0 truncate text-base font-bold text-paper">{vis?.nombre ?? 'Visitante'}</span>
        </span>
      </div>
      <div class="flex min-w-0 items-center gap-2 sm:flex-col sm:items-end">
        <span class={`rounded-full px-3 py-1 text-xs font-black uppercase tracking-wider shadow-sm ${tonoBadge[badge.tono] ?? ''}`}>{badge.texto}</span>
      </div>
      <div class="w-full border-t border-navy-700/60 pt-2 text-xs font-medium text-paper/75 sm:min-w-0 sm:max-w-[200px] sm:w-auto sm:border-0 sm:pt-0 sm:text-right">
        {partido.sede ?? 'Sede a confirmar'}
      </div>
      {partido.nota_publica && <p class="text-xs font-semibold text-gold-400 sm:min-w-0 sm:max-w-[220px] sm:text-right">{partido.nota_publica}</p>}
    </article>
  )
}
