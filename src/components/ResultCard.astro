---
// Card de partido/resultado para el hero y fechas: formato Scorebox TV deportivo profesional.
import Escudo from './Escudo.astro';
import type { PartidoVista } from '../lib/data';
import { etiquetaEstado, horaCorta } from '../lib/fmt';

interface Props {
  partido: PartidoVista;
}
const { partido } = Astro.props;

const loc = partido.local?.clubes;
const vis = partido.visitante?.clubes;

const esFinalizado = partido.estado === 'finalizado' || partido.estado === 'walkover';
const esEnJuego = partido.estado === 'en_juego';

const ganaL = esFinalizado && (
  (partido.estado === 'walkover' && partido.local?.id === partido.walkover_ganador_id) ||
  ((partido.puntos_local ?? 0) > (partido.puntos_visitante ?? 0))
);
const ganaV = esFinalizado && (
  (partido.estado === 'walkover' && partido.visitante?.id === partido.walkover_ganador_id) ||
  ((partido.puntos_visitante ?? 0) > (partido.puntos_local ?? 0))
);

const badge = etiquetaEstado(partido.estado);
const tonoBadge: Record<string, string> = {
  naranja: 'bg-orange-500 text-ink',
  dorado: 'bg-gold-400 text-ink',
  rojo: 'bg-red-500 text-paper',
  gris: 'bg-navy-950 text-paper/70 border border-navy-800',
};

const aria = esFinalizado
  ? `Resultado final ${partido.puntos_local}–${partido.puntos_visitante}, ${loc?.nombre ?? ''} vs ${vis?.nombre ?? ''}`
  : `Partido programado ${horaCorta(partido.fecha_hora)}, ${loc?.nombre ?? ''} vs ${vis?.nombre ?? ''}`;
---

<a
  href={`/partidos/${partido.id}`}
  aria-label={aria}
  class={`card-vigor group relative flex flex-col justify-between overflow-hidden p-3.5 sm:p-4.5 transition-all duration-200 hover:border-orange-500 hover:shadow-[0_8px_24px_rgba(0,0,0,0.4)] ${
    esFinalizado ? 'border-l-4 border-l-orange-500' : esEnJuego ? 'border-l-4 border-l-red-500 animate-pulse' : 'border-l-4 border-l-gold-400/60'
  }`}
>
  <!-- Top strip: Estado / Hora a la izquierda + Sede a la derecha -->
  <div class="flex items-center justify-between gap-2 border-b border-navy-800/80 pb-2.5 text-xs">
    <div class="flex items-center gap-2">
      {esFinalizado ? (
        <span class={`rounded-full px-2 py-0.5 text-[0.65rem] font-black uppercase tracking-wider ${tonoBadge[badge.tono] ?? tonoBadge.naranja}`}>
          {badge.texto}
        </span>
      ) : esEnJuego ? (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-red-500/20 px-2.5 py-0.5 text-[0.68rem] font-black uppercase tracking-wider text-red-400 border border-red-500/40">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 animate-ping"></span>
          EN JUEGO
        </span>
      ) : (
        <div class="flex items-center gap-2">
          <span class="num text-sm font-black text-orange-400">{horaCorta(partido.fecha_hora)}</span>
          <span class="rounded-full bg-navy-800 border border-navy-700 px-2 py-0.5 text-[0.62rem] font-bold uppercase tracking-wider text-paper/70">
            {badge.texto}
          </span>
        </div>
      )}
    </div>

    {partido.sede && (
      <span class="flex items-center gap-1 text-[0.68rem] font-medium text-paper/50 truncate max-w-[180px] sm:max-w-[240px]">
        <svg class="h-3 w-3 shrink-0 text-orange-400/80" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" />
        </svg>
        <span class="truncate">{partido.sede}</span>
      </span>
    )}
  </div>

  <!-- Equipos y Marcador -->
  <div class="mt-3 flex flex-col gap-2.5">
    <!-- Local -->
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <div class="shrink-0 transition-transform duration-200 group-hover:scale-105">
          <Escudo club={loc} tam="md" />
        </div>
        <span class={`min-w-0 truncate text-sm sm:text-base tracking-tight ${ganaL ? 'font-black text-paper' : esFinalizado ? 'font-medium text-paper/60' : 'font-bold text-paper'}`}>
          {loc?.nombre ?? 'Local'}
        </span>
      </div>
      {esFinalizado && (
        <span class={`num text-xl sm:text-2xl font-black shrink-0 ${ganaL ? 'text-orange-500 glow-orange' : 'text-paper/40'}`}>
          {partido.puntos_local ?? 0}
        </span>
      )}
    </div>

    <!-- Visitante -->
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <div class="shrink-0 transition-transform duration-200 group-hover:scale-105">
          <Escudo club={vis} tam="md" />
        </div>
        <span class={`min-w-0 truncate text-sm sm:text-base tracking-tight ${ganaV ? 'font-black text-paper' : esFinalizado ? 'font-medium text-paper/60' : 'font-bold text-paper'}`}>
          {vis?.nombre ?? 'Visitante'}
        </span>
      </div>
      {esFinalizado && (
        <span class={`num text-xl sm:text-2xl font-black shrink-0 ${ganaV ? 'text-orange-500 glow-orange' : 'text-paper/40'}`}>
          {partido.puntos_visitante ?? 0}
        </span>
      )}
    </div>
  </div>

  {partido.nota_publica && (
    <p class="m-0 mt-2.5 border-t border-navy-800/70 pt-1.5 text-center text-xs font-semibold text-gold-400">
      {partido.nota_publica}
    </p>
  )}
</a>
