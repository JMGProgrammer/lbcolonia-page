---
// Card de resultado del hero (mockup IT1): equipos a la izq, marcador a la der.
// Solo se le pasan partidos publicados (finalizado o walkover); enlaza a la ficha.
import Escudo from './Escudo.astro';
import type { PartidoVista } from '../lib/data';
import { etiquetaEstado } from '../lib/fmt';

interface Props {
  partido: PartidoVista;
}
const { partido } = Astro.props;

const loc = partido.local?.clubes;
const vis = partido.visitante?.clubes;
const marcador = partido.estado === 'walkover' ? 'W' : `${partido.puntos_local ?? ''}–${partido.puntos_visitante ?? ''}`;
const badge = etiquetaEstado(partido.estado);
const tonoBadge: Record<string, string> = {
  naranja: 'bg-orange-500 text-ink',
  dorado: 'bg-gold-400 text-ink',
};

const ganaL = partido.walkover_ganador_id && partido.local?.id === partido.walkover_ganador_id;
const ganaV = partido.walkover_ganador_id && partido.visitante?.id === partido.walkover_ganador_id;
const nombreLocal = (loc?.nombre ?? 'Local') + (ganaL ? ' · ganó' : '');
const nombreVisit = (vis?.nombre ?? 'Visitante') + (ganaV ? ' · ganó' : '');
const aria = `Resultado final ${marcador}, ${loc?.nombre ?? ''} vs ${vis?.nombre ?? ''}`;
---

<a
  href={`/partidos/${partido.id}`}
  aria-label={aria}
  class="card-vigor grid min-w-0 gap-3 p-4 sm:p-5 transition-all duration-200 hover:border-orange-500/50 hover:shadow-2xl sm:grid-cols-[1fr_auto] sm:items-center sm:gap-6"
>
  <div class="flex min-w-0 flex-col gap-3">
    <div class="flex min-w-0 items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-navy-950/80 p-1 border border-navy-700/60 shadow-sm">
        <Escudo club={loc} tam="md" />
      </div>
      <span class="min-w-0 truncate text-base sm:text-lg font-black tracking-tight text-paper">{nombreLocal}</span>
    </div>
    <div class="flex min-w-0 items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-navy-950/80 p-1 border border-navy-700/60 shadow-sm">
        <Escudo club={vis} tam="md" />
      </div>
      <span class="min-w-0 truncate text-base sm:text-lg font-black tracking-tight text-paper">{nombreVisit}</span>
    </div>
  </div>
  <div class="flex min-w-0 flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-2 border-t border-navy-700/60 pt-3 sm:border-t-0 sm:pt-0">
    <span class="num text-3xl sm:text-4xl font-black tracking-tight text-orange-500 glow-orange">{marcador}</span>
    <span class={`rounded-full px-3 py-1 text-xs font-black uppercase tracking-wider shadow-sm ${tonoBadge[badge.tono] ?? ''}`}>{badge.texto}</span>
  </div>
  {
    partido.nota_publica && (
      <p class="col-span-full min-w-0 border-t border-navy-700/60 pt-2.5 text-center text-xs sm:text-sm font-semibold text-gold-400 sm:max-w-[480px] sm:justify-self-center">{partido.nota_publica}</p>
    )
  }
</a>
