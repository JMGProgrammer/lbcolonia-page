---
// Card de partido/resultado para el hero y fechas: formato Scorebox TV deportivo profesional.
import Escudo from './Escudo.astro';
import type { PartidoVista } from '../lib/data';
import { etiquetaEstado, horaCorta } from '../lib/fmt';

interface Props {
  partido: PartidoVista;
}
const { partido } = Astro.props;

const loc = partido.local?.clubes;
const vis = partido.visitante?.clubes;

const esFinalizado = partido.estado === 'finalizado' || partido.estado === 'walkover';
const esEnJuego = partido.estado === 'en_juego';

const ganaL = esFinalizado && (
  (partido.estado === 'walkover' && partido.local?.id === partido.walkover_ganador_id) ||
  ((partido.puntos_local ?? 0) > (partido.puntos_visitante ?? 0))
);
const ganaV = esFinalizado && (
  (partido.estado === 'walkover' && partido.visitante?.id === partido.walkover_ganador_id) ||
  ((partido.puntos_visitante ?? 0) > (partido.puntos_local ?? 0))
);

const badge = etiquetaEstado(partido.estado);
const tonoBadge: Record<string, string> = {
  naranja: 'bg-orange-500 text-ink',
  dorado: 'bg-gold-400 text-ink',
  rojo: 'bg-red-500 text-paper',
  gris: 'bg-navy-950 text-paper/70 border border-navy-800',
};

const aria = esFinalizado
  ? `Resultado final ${partido.puntos_local}–${partido.puntos_visitante}, ${loc?.nombre ?? ''} vs ${vis?.nombre ?? ''}`
  : `Partido programado ${horaCorta(partido.fecha_hora)}, ${loc?.nombre ?? ''} vs ${vis?.nombre ?? ''}`;
---

<a
  href={`/partidos/${partido.id}`}
  aria-label={aria}
  class="card-vigor group relative grid min-w-0 gap-3 p-3.5 sm:p-4 transition-all duration-150 hover:border-orange-500 hover:shadow-xl sm:grid-cols-[1fr_auto] sm:items-center sm:gap-4"
>
  <!-- Equipos (local arriba, visitante abajo con escudos libres sin marco) -->
  <div class="flex min-w-0 flex-col gap-2.5">
    <div class="flex min-w-0 items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <Escudo club={loc} tam="md" />
        <span class={`min-w-0 truncate text-base sm:text-lg tracking-tight ${ganaL ? 'font-black text-paper' : esFinalizado ? 'font-semibold text-paper/60' : 'font-extrabold text-paper'}`}>
          {loc?.nombre ?? 'Local'}
        </span>
      </div>
      {esFinalizado && (
        <span class={`num text-xl sm:text-2xl font-black ${ganaL ? 'text-orange-500 glow-orange' : 'text-paper/50'}`}>
          {partido.puntos_local ?? 0}
        </span>
      )}
    </div>

    <div class="flex min-w-0 items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-3">
        <Escudo club={vis} tam="md" />
        <span class={`min-w-0 truncate text-base sm:text-lg tracking-tight ${ganaV ? 'font-black text-paper' : esFinalizado ? 'font-semibold text-paper/60' : 'font-extrabold text-paper'}`}>
          {vis?.nombre ?? 'Visitante'}
        </span>
      </div>
      {esFinalizado && (
        <span class={`num text-xl sm:text-2xl font-black ${ganaV ? 'text-orange-500 glow-orange' : 'text-paper/50'}`}>
          {partido.puntos_visitante ?? 0}
        </span>
      )}
    </div>
  </div>

  <!-- Panel lateral derecho compacto con bordes rectos -->
  <div class="flex min-w-[110px] flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-1.5 border-t border-navy-700/60 pt-2.5 sm:border-t-0 sm:border-l sm:border-navy-800/80 sm:pl-4 sm:pt-0">
    {esFinalizado ? (
      <>
        <div class="hidden sm:block text-right">
          <span class="num text-2xl sm:text-3xl font-black tracking-tight text-orange-500 glow-orange">
            {partido.estado === 'walkover' ? 'W.O.' : `${partido.puntos_local}–${partido.puntos_visitante}`}
          </span>
        </div>
        <span class={`px-2.5 py-0.5 text-[0.7rem] font-black uppercase tracking-wider ${tonoBadge[badge.tono] ?? tonoBadge.naranja}`}>
          {badge.texto}
        </span>
      </>
    ) : esEnJuego ? (
      <>
        <span class="num text-2xl font-black text-red-500 animate-pulse">
          {partido.puntos_local ?? 0}–{partido.puntos_visitante ?? 0}
        </span>
        <span class="inline-flex items-center gap-1.5 bg-red-500/20 px-2.5 py-0.5 text-[0.7rem] font-black uppercase tracking-wider text-red-400 border border-red-500/40">
          <span class="h-1.5 w-1.5 bg-red-500 animate-ping"></span>
          EN JUEGO
        </span>
      </>
    ) : (
      <>
        <span class="num text-xl sm:text-2xl font-black tracking-tight text-paper">
          {horaCorta(partido.fecha_hora)}
        </span>
        <span class={`px-2 py-0.5 text-[0.68rem] font-bold uppercase tracking-wider ${tonoBadge[badge.tono] ?? tonoBadge.gris}`}>
          {badge.texto}
        </span>
        {partido.sede && (
          <span class="hidden sm:block text-right text-[0.7rem] font-medium text-paper/60 max-w-[120px] truncate">
            {partido.sede}
          </span>
        )}
      </>
    )}
  </div>

  {
    partido.nota_publica && (
      <p class="col-span-full min-w-0 border-t border-navy-700/60 pt-2 text-center text-xs font-semibold text-gold-400 sm:justify-self-center">
        {partido.nota_publica}
      </p>
    )
  }
</a>
