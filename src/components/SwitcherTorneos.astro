---
// Chips de competencias (mockup IT1): torneos como switcher sobre fixture/tabla.
import type { TorneoInfo } from '../lib/data';

interface Props {
  torneos: TorneoInfo[];
  activoId?: string;
  rutaBase: string;
  filtroExtra?: string; // querystring adicional (club/ronda), sin la inicial "?"
}
const { torneos, activoId, rutaBase, filtroExtra = '' } = Astro.props;

const anio = new Date().getFullYear();
const qsExtra = filtroExtra ? `&${filtroExtra}` : '';
---

<div class="border-b border-navy-700 bg-navy-900">
  <nav class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-2 px-4 py-2.5" aria-label="Competencias">
    {
      torneos.map((t) => {
        const activa = t.id === activoId;
        return (
          <a
            href={`${rutaBase}?torneo=${t.id}${qsExtra}`}
            aria-current={activa ? 'true' : undefined}
            class={`border px-3.5 py-1.5 text-[0.8rem] font-bold uppercase tracking-[0.09em] no-underline transition-colors ${
              activa
                ? 'border-orange-500 bg-orange-500 text-ink shadow-[0_2px_8px_rgba(238,107,31,0.3)]'
                : 'border-navy-700 bg-navy-950/60 text-paper-muted hover:border-orange-500 hover:text-paper'
            }`}
          >
            {t.categorias?.nombre ?? t.nombre}
          </a>
        );
      })
    }
    <span class="ml-auto text-[0.72rem] uppercase tracking-[0.06em] text-paper-muted">
      Temporada <strong class="text-gold-400 tracking-[0.1em]">#LBC{anio}</strong>
    </span>
  </nav>
</div>
