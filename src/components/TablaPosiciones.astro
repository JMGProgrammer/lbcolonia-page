---
// Tabla de posiciones: columnas del mockup (# Equipo PJ PG PP GF GC DIF PTS).
// Los tie-breakers extra (pw/pdw) se usan en el ORDER del backend, no se muestran.
import type { FilaTabla } from '../lib/data';

interface Props {
  filas: FilaTabla[];
  caption?: string;
}
const { filas, caption } = Astro.props;
---

<div class="overflow-hidden rounded-panel border border-navy-700">
  <div class="overflow-x-auto">
    {
      filas.length === 0 ? (
        <p class="p-6 text-center text-sm text-paper-muted">Aún no hay partidos publicados de este torneo.</p>
      ) : (
        <table class="min-w-[560px] w-full border-collapse bg-navy-800">
          {caption && <caption class="bg-navy-800 px-3 py-2.5 text-left text-[0.78rem] font-extrabold uppercase tracking-[0.22em] text-gold-400">{caption}</caption>}
          <thead>
            <tr>
              {['#', 'Equipo', 'PJ', 'PG', 'PP', 'GF', 'GC', 'DIF', 'PTS'].map((h, i) => (
                <th
                  scope="col"
                  class={`whitespace-nowrap bg-orange-500 px-3 py-2.5 text-[0.72rem] uppercase tracking-[0.12em] text-ink ${
                    i === 0 ? 'text-left' : i === 1 ? 'text-left' : 'text-right'
                  }`}
                >
                  {h}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {filas.map((f, i) => {
              const dif = f.dif ?? 0;
              const claseDif = dif > 0 ? 'text-[#7fd49a]' : dif < 0 ? 'text-[#e89a9a]' : 'text-paper-muted';
              return (
                <tr class="border-t border-navy-700 hover:bg-navy-900">
                  <td class={`px-3 py-3 ${i === 0 ? 'font-black text-gold-400' : 'text-paper-muted'}`}>{i + 1}</td>
                  <td class="px-3 py-3 text-[0.95rem] font-bold">{f.equipo ?? '—'}</td>
                  <td class="num px-3 py-3 text-right">{f.pj ?? 0}</td>
                  <td class="num px-3 py-3 text-right">{f.pg ?? 0}</td>
                  <td class="num px-3 py-3 text-right">{f.pp ?? 0}</td>
                  <td class="num px-3 py-3 text-right">{f.gf ?? 0}</td>
                  <td class="num px-3 py-3 text-right">{f.gc ?? 0}</td>
                  <td class={`num px-3 py-3 text-right ${claseDif}`}>
                    {dif > 0 ? '+' : dif < 0 ? '−' : ''}
                    {Math.abs(dif)}
                  </td>
                  <td class="num px-3 py-3 text-right text-base font-black text-orange-500">{f.pts ?? 0}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )
    }
  </div>
</div>
