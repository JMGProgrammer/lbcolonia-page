---
// Tabla de posiciones: columnas del mockup (# Equipo PJ PG PP GF GC DIF PTS).
// Los tie-breakers extra (pw/pdw) se usan en el ORDER del backend, no se muestran.
import type { FilaTabla } from '../lib/data';

interface Props {
  filas: FilaTabla[];
  caption?: string;
}
const { filas, caption } = Astro.props;
---

<div class="card-vigor overflow-hidden border border-navy-700/80 shadow-2xl">
  <div class="overflow-x-auto">
    {
      filas.length === 0 ? (
        <p class="p-8 text-center text-sm font-semibold text-paper-muted">Aún no hay partidos publicados de este torneo.</p>
      ) : (
        <table class="min-w-[600px] w-full border-collapse bg-navy-950/60">
          {caption && <caption class="bg-navy-900/90 px-4 py-3 text-left text-xs sm:text-sm font-black uppercase tracking-widest text-gold-400 border-b border-navy-700/70">{caption}</caption>}
          <thead>
            <tr class="border-b border-navy-700/80">
              {['#', 'Equipo', 'PJ', 'PG', 'PP', 'GF', 'GC', 'DIF', 'PTS'].map((h, i) => (
                <th
                  scope="col"
                  class={`whitespace-nowrap bg-orange-500 px-3.5 py-3 text-xs font-black uppercase tracking-wider text-ink shadow-sm ${
                    i === 0 ? 'text-left w-12' : i === 1 ? 'text-left' : 'text-right'
                  }`}
                >
                  {h}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-navy-800/80">
            {filas.map((f, i) => {
              const dif = f.dif ?? 0;
              const claseDif = dif > 0 ? 'text-emerald-400 font-bold' : dif < 0 ? 'text-red-400 font-bold' : 'text-paper-muted';
              return (
                <tr class="hover:bg-navy-800/60 transition-colors">
                  <td class={`px-3.5 py-3.5 text-sm ${i === 0 ? 'font-black text-gold-400' : 'font-bold text-paper-muted'}`}>{i + 1}</td>
                  <td class="px-3.5 py-3.5 text-sm sm:text-base font-extrabold text-paper">{f.equipo ?? '—'}</td>
                  <td class="num px-3.5 py-3.5 text-right text-sm font-bold">{f.pj ?? 0}</td>
                  <td class="num px-3.5 py-3.5 text-right text-sm font-bold text-emerald-400">{f.pg ?? 0}</td>
                  <td class="num px-3.5 py-3.5 text-right text-sm font-bold text-red-400">{f.pp ?? 0}</td>
                  <td class="num px-3.5 py-3.5 text-right text-sm font-bold text-paper/80">{f.gf ?? 0}</td>
                  <td class="num px-3.5 py-3.5 text-right text-sm font-bold text-paper/80">{f.gc ?? 0}</td>
                  <td class={`num px-3.5 py-3.5 text-right text-sm ${claseDif}`}>
                    {dif > 0 ? '+' : dif < 0 ? '−' : ''}
                    {Math.abs(dif)}
                  </td>
                  <td class="num px-3.5 py-3.5 text-right text-base sm:text-lg font-black text-orange-500 glow-orange">{f.pts ?? 0}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )
    }
  </div>
</div>
