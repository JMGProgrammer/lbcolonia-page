---
// Topbar sticky (patrón mockup IT1): menú móvil solo-CSS con checkbox + :has().
// Nota: el label "Menú" es para versión táctil; en desktop la nav siempre abre.
const links = [
  { href: '/fixture', texto: 'Fixture' },
  { href: '/tabla', texto: 'Tabla' },
  { href: '/clubes', texto: 'Clubes' },
  { href: '/sanciones', texto: 'Sanciones' },
  { href: '/noticias', texto: 'Noticias' },
];
---

<header class="sticky top-0 z-30 border-b border-navy-700 bg-navy-950/95 backdrop-blur-sm">
  <div class="mx-auto flex min-h-16 max-w-[1200px] items-center gap-3 px-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5 no-underline">
      <img src="/logo-lbc-bgr.png" alt="Escudo de la Liga de Básquetbol de Colonia" width="40" height="47" class="h-10 w-auto" />
      <span class="hidden min-[480px]:flex flex-col leading-tight">
        <strong class="text-base font-black tracking-[0.02em]">LBC</strong>
        <span class="text-[0.68rem] uppercase tracking-[0.14em] text-paper-muted">Liga de Básquetbol · Colonia</span>
      </span>
    </a>
    <input id="topbar-menu" type="checkbox" class="topbar-menu checked:sr-only sr-only" aria-label="Mostrar menú" />
    <label for="topbar-menu" class="ml-auto cursor-pointer rounded-lg border border-navy-700 px-3 py-2 text-[0.78rem] font-bold uppercase tracking-[0.1em] text-paper transition-colors hover:border-orange-500 md:hidden">Menú</label>
    <nav class="topbar-nav hidden md:ml-auto md:flex md:items-center md:gap-1" aria-label="Navegación principal">
      {
        links.map((l) => (
          <a href={l.href} class="rounded-lg px-2.5 py-2 text-[0.9rem] font-semibold text-paper-muted no-underline transition-colors hover:text-paper md:px-2">
            {l.texto}
          </a>
        ))
      }
    </nav>
  </div>
</header>
