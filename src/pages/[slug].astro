---
// Ruta única de las páginas de la liga (/contacto, /reglamento, …).
// RLS: solo se muestran las publicadas; lo demás cae en la vía del 404 útil.
import Base from '../layouts/Base.astro';
import Rotulo from '../components/Rotulo.astro';
import { paginaPorSlug } from '../lib/data';
import { renderMarkdown, escHtml } from '../lib/fmt';

const { slug } = Astro.params;
const pagina = slug && /^[a-z0-9-]+$/.test(slug) ? await paginaPorSlug(slug) : null;
if (!pagina) Astro.response.status = 404;
---

<Base
  title={pagina?.titulo ?? 'Página no encontrada'}
  description={pagina ? `${pagina.titulo} de la Liga de Básquetbol de Colonia.` : 'No encontramos esta página en el sitio de la LBC.'}
>
  {
    pagina ? (
      <article class="py-8 lg:max-w-[820px]">
        <Rotulo>Liga de Básquetbol de Colonia</Rotulo>
        <h1 class="text-2xl font-black lg:text-4xl">{pagina.titulo}</h1>
        {
          pagina.cuerpo_md ? (
            <div class="mt-6" set:html={renderMarkdown(pagina.cuerpo_md)} />
          ) : (
            <p class="mt-6 text-paper-muted">Contenido por completarse por la liga.</p>
          )
        }
      </article>
    ) : (
      <section class="py-20 text-center">
        <h1 class="text-2xl font-extrabold">No encontramos esta página</h1>
        <p class="mt-2 text-paper-muted">Las páginas de la liga están en /contacto y /reglamento.</p>
        <a href="/" class="mt-6 inline-block rounded-full bg-orange-500 px-6 py-2.5 text-[0.9rem] font-extrabold text-ink no-underline hover:bg-orange-700">
          Volver al inicio
        </a>
      </section>
    )
  }
</Base>
