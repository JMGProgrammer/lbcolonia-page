---
// Hub principal del panel administrativo de la liga (/admin)
// Docs/05 §1A: Bandeja de entrada con pendientes del día, métricas y accesos directos
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Resumen" seccionActiva="resumen">
  <div class="space-y-8">
    <!-- Banner de bienvenida institucional con vigor y presencia -->
    <div class="relative overflow-hidden rounded-2xl border border-orange-500/30 bg-leather-subtle p-7 sm:p-9 shadow-2xl">
      <!-- Glow ambiental deportivo -->
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-orange-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-10 -top-10 w-64 h-64 bg-navy-700/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full bg-navy-950/80 border border-gold-400/40 px-3 py-1 shadow-sm">
            <span class="h-2 w-2 rounded-full bg-orange-500 animate-pulse"></span>
            <span class="text-xs font-extrabold uppercase tracking-widest text-gold-400">
              Temporada Oficial 2026
            </span>
          </div>
          <h1 class="mt-3 text-2xl sm:text-4xl font-black uppercase tracking-wider text-paper drop-shadow">
            Secretaría de la Liga
          </h1>
          <p class="mt-2 text-sm sm:text-base text-paper-muted font-medium leading-relaxed">
            Liga de Básquetbol de Colonia · Centro de control operativo para el fin de semana, fiscalización y difusión oficial.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/admin/fixture/importar"
            class="inline-flex items-center gap-2.5 rounded-xl bg-orange-500 px-5 py-3.5 text-sm font-black uppercase tracking-wider text-ink transition-all hover:bg-orange-600 hover:shadow-lg hover:shadow-orange-500/25 active:scale-[0.98]"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            Pegar Excel
          </a>
          <a
            href="/admin/fixture"
            class="inline-flex items-center gap-2 rounded-xl border border-navy-700 bg-navy-900/90 px-4 py-3.5 text-sm font-bold uppercase tracking-wider text-paper hover:bg-navy-800 hover:border-navy-600 transition-all shadow-md"
          >
            Ver Fixture
          </a>
        </div>
      </div>
    </div>

    <!-- Bandeja de Pendientes del Día (Inbox de Secretaría) -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-black uppercase tracking-wider text-paper flex items-center gap-2.5">
          <span class="h-3 w-1 bg-orange-500 rounded-full"></span>
          <span>Bandeja de pendientes del día</span>
          <span id="badge-total-pendientes" class="hidden rounded-full bg-orange-500/20 border border-orange-500/40 px-2.5 py-0.5 text-xs font-bold text-orange-400">
            0 pendientes
          </span>
        </h2>
        <span class="text-xs text-paper-muted font-medium">Actualizado en vivo</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Pendiente 1: Fichas solicitadas -->
        <a
          href="/admin/fichas"
          id="card-pendiente-fichas"
          class="card-vigor group flex flex-col justify-between rounded-xl p-5"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-paper-muted">Fichas por confirmar</span>
              <span id="indicador-fichas" class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            </div>
            <p id="inbox-fichas-solicitadas" class="mt-2 text-3xl font-black num text-paper">0</p>
          </div>
          <p class="mt-3 text-xs font-semibold text-paper-muted group-hover:text-orange-400 transition-colors flex items-center gap-1">
            <span>Revisar solicitudes</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </p>
        </a>

        <!-- Pendiente 2: Resultados cargados sin publicar -->
        <a
          href="/admin/fixture"
          id="card-pendiente-publicar"
          class="card-vigor group flex flex-col justify-between rounded-xl p-5"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-paper-muted">Marcadores sin publicar</span>
              <span id="indicador-publicar" class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            </div>
            <p id="inbox-sin-publicar" class="mt-2 text-3xl font-black num text-paper">0</p>
          </div>
          <p class="mt-3 text-xs font-semibold text-paper-muted group-hover:text-orange-400 transition-colors flex items-center gap-1">
            <span>Publicar en la tabla</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </p>
        </a>

        <!-- Pendiente 3: Partidos programados sin sede -->
        <a
          href="/admin/fixture"
          id="card-pendiente-sede"
          class="card-vigor group flex flex-col justify-between rounded-xl p-5"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-paper-muted">Partidos sin sede fija</span>
              <span id="indicador-sede" class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            </div>
            <p id="inbox-sin-sede" class="mt-2 text-3xl font-black num text-paper">0</p>
          </div>
          <p class="mt-3 text-xs font-semibold text-paper-muted group-hover:text-orange-400 transition-colors flex items-center gap-1">
            <span>Asignar gimnasio</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </p>
        </a>

        <!-- Pendiente 4: Planillas con disputa / por verificar -->
        <div
          id="card-pendiente-disputas"
          class="card-vigor rounded-xl p-5"
        >
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-paper-muted">Planillas en disputa</span>
            <span id="indicador-disputas" class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          </div>
          <p id="inbox-disputas" class="mt-2 text-3xl font-black num text-paper">0</p>
          <p class="mt-3 text-xs text-paper-muted">
            Observaciones de delegados
          </p>
        </div>
      </div>
    </div>

    <!-- Métricas rápidas del torneo -->
    <div>
      <h2 class="text-sm font-black uppercase tracking-wider text-paper flex items-center gap-2.5 mb-4">
        <span class="h-3 w-1 bg-gold-400 rounded-full"></span>
        <span>Métricas oficiales del torneo</span>
      </h2>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="card-vigor rounded-xl p-5">
          <p class="text-xs font-bold uppercase tracking-wider text-paper-muted">Total partidos</p>
          <p id="stat-total" class="mt-2 text-3xl font-black num text-paper">-</p>
          <span class="text-xs text-paper-muted">En el fixture oficial</span>
        </div>

        <div class="card-vigor rounded-xl p-5">
          <p class="text-xs font-bold uppercase tracking-wider text-paper-muted">Programados</p>
          <p id="stat-programados" class="mt-2 text-3xl font-black num text-paper">-</p>
          <span class="text-xs text-paper-muted">Por disputarse</span>
        </div>

        <div class="card-vigor rounded-xl p-5">
          <p class="text-xs font-bold uppercase tracking-wider text-paper-muted">Finalizados</p>
          <p id="stat-finalizados" class="mt-2 text-3xl font-black num text-orange-500">-</p>
          <span class="text-xs text-paper-muted">Con tanteador cargado</span>
        </div>

        <div class="card-vigor rounded-xl p-5">
          <p class="text-xs font-bold uppercase tracking-wider text-paper-muted">Publicados</p>
          <p id="stat-publicados" class="mt-2 text-3xl font-black num text-gold-400">-</p>
          <span class="text-xs text-paper-muted">En sitio público</span>
        </div>
      </div>
    </div>

    <!-- Módulos de administración -->
    <div>
      <h2 class="text-sm font-black uppercase tracking-wider text-paper flex items-center gap-2.5 mb-4">
        <span class="h-3 w-1 bg-orange-500 rounded-full"></span>
        <span>Módulos de secretaría y competencia</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Módulo 1: Fixture -->
        <a
          href="/admin/fixture"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-500/15 text-orange-400 group-hover:bg-orange-500 group-hover:text-ink transition-colors">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </div>
              <span class="rounded bg-navy-800 border border-navy-700 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-paper-muted">
                Agenda
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-paper group-hover:text-orange-500 transition-colors">
              Fixture y Resultados
            </h3>
            <p class="mt-2 text-xs text-paper-muted leading-relaxed">
              Carga manual de marcadores, parciales por cuarto, walkovers y publicación oficial para la tabla.
            </p>
          </div>
          <div class="mt-4 text-xs font-bold text-orange-500 flex items-center gap-1">
            <span>Abrir fixture</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>

        <!-- Módulo 2: Pegar Excel -->
        <a
          href="/admin/fixture/importar"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gold-400/15 text-gold-400 group-hover:bg-gold-400 group-hover:text-ink transition-colors">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="12" y1="18" x2="12" y2="12"></line>
                  <line x1="9" y1="15" x2="15" y2="15"></line>
                </svg>
              </div>
              <span class="rounded bg-navy-800 border border-navy-700 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-gold-400">
                1 Clic
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-paper group-hover:text-orange-500 transition-colors">
              Importar desde Excel
            </h3>
            <p class="mt-2 text-xs text-paper-muted leading-relaxed">
              Pegado masivo de jornadas completas con detector inteligente de clubes y previsualizador.
            </p>
          </div>
          <div class="mt-4 text-xs font-bold text-orange-500 flex items-center gap-1">
            <span>Pegar fixture</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>

        <!-- Módulo 3: Fichas -->
        <a
          href="/admin/fichas"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-500/15 text-orange-400 group-hover:bg-orange-500 group-hover:text-ink transition-colors">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              </div>
              <span class="rounded bg-navy-800 border border-navy-700 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-paper-muted">
                Pases
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-paper group-hover:text-orange-500 transition-colors">
              Gestión de Fichas
            </h3>
            <p class="mt-2 text-xs text-paper-muted leading-relaxed">
              Bandeja para confirmar solicitudes de delegados, fijar dorsales y tramitar bajas reglamentarias.
            </p>
          </div>
          <div class="mt-4 text-xs font-bold text-orange-500 flex items-center gap-1">
            <span>Gestionar fichas</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>

        <!-- Módulo 4: Padrón de Jugadores -->
        <a
          href="/admin/jugadores"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-500/15 text-orange-400 group-hover:bg-orange-500 group-hover:text-ink transition-colors">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="rounded bg-navy-800 border border-navy-700 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-paper-muted">
                Padrón
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-paper group-hover:text-orange-500 transition-colors">
              Jugadores
            </h3>
            <p class="mt-2 text-xs text-paper-muted leading-relaxed">
              Padrón oficial federado con detector automático de duplicados y homónimos en tiempo real.
            </p>
          </div>
          <div class="mt-4 text-xs font-bold text-orange-500 flex items-center gap-1">
            <span>Ver padrón</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>

        <!-- Módulo 5: Clubes y Equipos -->
        <a
          href="/admin/clubes"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-500/15 text-orange-400 group-hover:bg-orange-500 group-hover:text-ink transition-colors">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <span class="rounded bg-navy-800 border border-navy-700 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-paper-muted">
                Clubes
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-paper group-hover:text-orange-500 transition-colors">
              Clubes y Equipos
            </h3>
            <p class="mt-2 text-xs text-paper-muted leading-relaxed">
              Colores oficiales con selector en vivo, gimnasio sede y categorías asociadas por club.
            </p>
          </div>
          <div class="mt-4 text-xs font-bold text-orange-500 flex items-center gap-1">
            <span>Administrar clubes</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>

        <!-- Módulo 6: Torneos y Categorías -->
        <a
          href="/admin/torneos"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-500/15 text-orange-400 group-hover:bg-orange-500 group-hover:text-ink transition-colors">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                  <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                  <path d="M4 22h16"></path>
                  <path d="M10 14.66V17c0 .55-.45 1-1 1H7v2h10v-2h-2c-.55 0-1-.45-1-1v-2.34"></path>
                  <path d="M6 4h12v7a6 6 0 0 1-12 0V4Z"></path>
                </svg>
              </div>
              <span class="rounded bg-navy-800 border border-navy-700 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-paper-muted">
                Torneos
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-paper group-hover:text-orange-500 transition-colors">
              Torneos y Reglas
            </h3>
            <p class="mt-2 text-xs text-paper-muted leading-relaxed">
              Formatos de liga, sistema de puntuación FIBA y nivel de estadísticas por categoría.
            </p>
          </div>
          <div class="mt-4 text-xs font-bold text-orange-500 flex items-center gap-1">
            <span>Configurar torneos</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>

        <!-- Módulo 7: Noticias y Prensa -->
        <a
          href="/admin/noticias"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-500/15 text-orange-400 group-hover:bg-orange-500 group-hover:text-ink transition-colors">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
                  <path d="M18 14h-8"></path>
                  <path d="M15 18h-5"></path>
                  <path d="M10 6h8v4h-8V6Z"></path>
                </svg>
              </div>
              <span class="rounded bg-navy-800 border border-navy-700 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-paper-muted">
                Prensa
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-paper group-hover:text-orange-500 transition-colors">
              Noticias y Crónicas
            </h3>
            <p class="mt-2 text-xs text-paper-muted leading-relaxed">
              Editor Markdown con vista previa en vivo, imágenes de portada y noticias destacadas.
            </p>
          </div>
          <div class="mt-4 text-xs font-bold text-orange-500 flex items-center gap-1">
            <span>Redactar noticias</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>

        <!-- Módulo 8: Páginas Institucionales -->
        <a
          href="/admin/paginas"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-500/15 text-orange-400 group-hover:bg-orange-500 group-hover:text-ink transition-colors">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
              <span class="rounded bg-navy-800 border border-navy-700 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-paper-muted">
                Páginas
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold text-paper group-hover:text-orange-500 transition-colors">
              Páginas del Sitio
            </h3>
            <p class="mt-2 text-xs text-paper-muted leading-relaxed">
              Estatutos, reglamentos oficiales, autoridades del tribunal de penas y contacto.
            </p>
          </div>
          <div class="mt-4 text-xs font-bold text-orange-500 flex items-center gap-1">
            <span>Editar páginas</span>
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>

        <!-- Módulo 9: Auspiciantes Comerciales -->
        <a
          href="/admin/auspiciantes"
          class="card-vigor group flex flex-col justify-between rounded-xl p-6"
        >
          <div>
            <div class="flex items-center justify-between">
