<script>
  import { supabaseBrowser } from '../../lib/supabase-browser';

  async function cargarResumen() {
    try {
      // 1. Métricas de partidos
      const { data: partidos } = await supabaseBrowser
        .from('partidos')
        .select('id, estado, publicado, sede');

      if (partidos) {
        const total = partidos.length;
        const programados = partidos.filter((p) => p.estado === 'programado').length;
        const finalizados = partidos.filter((p) => p.estado === 'finalizado' || p.estado === 'walkover').length;
        const publicados = partidos.filter((p) => p.publicado).length;

        const sinPublicar = partidos.filter((p) => (p.estado === 'finalizado' || p.estado === 'walkover') && !p.publicado).length;
        const sinSede = partidos.filter((p) => p.estado === 'programado' && (!p.sede || p.sede.trim() === '')).length;

        const elTotal = document.getElementById('stat-total');
        const elProg = document.getElementById('stat-programados');
        const elFin = document.getElementById('stat-finalizados');
        const elPub = document.getElementById('stat-publicados');

        if (elTotal) elTotal.textContent = String(total);
        if (elProg) elProg.textContent = String(programados);
        if (elFin) elFin.textContent = String(finalizados);
        if (elPub) elPub.textContent = String(publicados);

        const elSinPub = document.getElementById('inbox-sin-publicar');
        const indPub = document.getElementById('indicador-publicar');
        if (elSinPub) elSinPub.textContent = String(sinPublicar);
        if (indPub) {
          indPub.className = sinPublicar > 0 ? 'h-2.5 w-2.5 rounded-full bg-amber-400 animate-pulse' : 'h-2.5 w-2.5 rounded-full bg-emerald-500';
        }

        const elSinSede = document.getElementById('inbox-sin-sede');
        const indSede = document.getElementById('indicador-sede');
        if (elSinSede) elSinSede.textContent = String(sinSede);
        if (indSede) {
          indSede.className = sinSede > 0 ? 'h-2.5 w-2.5 rounded-full bg-amber-400 animate-pulse' : 'h-2.5 w-2.5 rounded-full bg-emerald-500';
        }
      }

      // 2. Fichas solicitadas
      const { data: fichas } = await supabaseBrowser
        .from('fichas')
        .select('id, estado');

      let totalFichasSolicitadas = 0;
      if (fichas) {
        totalFichasSolicitadas = fichas.filter((f) => f.estado === 'solicitada').length;
        const elFichasSol = document.getElementById('inbox-fichas-solicitadas');
        const indFichas = document.getElementById('indicador-fichas');
        if (elFichasSol) elFichasSol.textContent = String(totalFichasSolicitadas);
        if (indFichas) {
          indFichas.className = totalFichasSolicitadas > 0 ? 'h-2.5 w-2.5 rounded-full bg-amber-400 animate-pulse' : 'h-2.5 w-2.5 rounded-full bg-emerald-500';
        }
      }

      // 3. Planillas en disputa
      const { data: planillas } = await supabaseBrowser
        .from('planillas')
        .select('id, estado');

      let totalDisputas = 0;
      if (planillas) {
        totalDisputas = planillas.filter((p) => p.estado === 'disputada').length;
        const elDisputas = document.getElementById('inbox-disputas');
        const indDisputas = document.getElementById('indicador-disputas');
        if (elDisputas) elDisputas.textContent = String(totalDisputas);
        if (indDisputas) {
          indDisputas.className = totalDisputas > 0 ? 'h-2.5 w-2.5 rounded-full bg-amber-400 animate-pulse' : 'h-2.5 w-2.5 rounded-full bg-emerald-500';
        }
      }

      // Total de pendientes
      const totalPendientes = totalFichasSolicitadas + totalDisputas;
      const badgePendientes = document.getElementById('badge-total-pendientes');
      if (badgePendientes) {
        if (totalPendientes > 0) {
          badgePendientes.textContent = `${totalPendientes} pendientes`;
          badgePendientes.classList.remove('hidden');
        } else {
          badgePendientes.classList.add('hidden');
        }
      }
    } catch (e) {
      console.error('Error cargando estadísticas resumen:', e);
    }
  }

  window.addEventListener('admin-auth-ok', cargarResumen);
  cargarResumen();
</script>
