---
// Ficha oficial de club: escudo grande, reseña cultural/histórica estilo enciclopédico,
// planteles por categoría desplegables en fichas oficiales y fixture propio.
import Base from '../../layouts/Base.astro';
import Escudo from '../../components/Escudo.astro';
import PartidoFila from '../../components/PartidoFila.astro';
import JugadorFicha from '../../components/JugadorFicha.astro';
import {
  clubPorSlug,
  listarTorneos,
  listarPartidosDeTorneo,
  listarEquiposDeClube,
  rosterDeEquipos,
} from '../../lib/data';
import type { FichaRoster } from '../../lib/data';
import { obtenerCulturaClub } from '../../lib/clubes-info';

const { slug } = Astro.params;
const club = slug ? await clubPorSlug(slug) : null;
if (!club) Astro.response.status = 404;

const cultura = club ? obtenerCulturaClub(club.slug, club.nombre) : null;
const torneos = await listarTorneos();
const equipos = club ? await listarEquiposDeClube(club.id) : [];
equipos.sort((a, b) => (a.categorias?.orden ?? 9) - (b.categorias?.orden ?? 9));

const teamIds = new Set(equipos.map((e) => e.id));
const roster = teamIds.size > 0 ? await rosterDeEquipos([...teamIds]) : [];
const rosterPorEquipo = new Map<string, FichaRoster[]>();
for (const f of roster) {
  if (f.estado === 'baja') continue;
  const lista = rosterPorEquipo.get(f.equipo_id) ?? [];
  lista.push(f);
  rosterPorEquipo.set(f.equipo_id, lista);
}

/* calendario del club: partidos de cada torneo donde participe alguno de sus equipos */
const porTorneo = (
  await Promise.all(
    torneos.map(async (t) => ({
      torneo: t,
      partidos: (await listarPartidosDeTorneo(t.id)).filter(
        (p) => teamIds.has(p.local?.id ?? '') || teamIds.has(p.visitante?.id ?? '')
      ),
    }))
  )
).filter((x) => x.partidos.length > 0);
---

<Base
  title={club ? `${club.nombre} · Club Oficial LBC` : 'Club'}
  description={club ? `${cultura?.nombreOficial ?? club.nombre} en la Liga de Básquetbol de Colonia: historia, identidad, planteles y fixture oficial.` : 'Club de la LBC.'}
>
  {
    !club ? (
      <section class="py-20 text-center">
        <h1 class="text-2xl font-black text-paper">Club no encontrado</h1>
        <p class="mt-2 text-paper-muted">No encontramos el club solicitado en los registros oficiales.</p>
        <a href="/clubes" class="mt-6 inline-block bg-orange-500 px-6 py-2.5 text-xs font-black uppercase tracking-wider text-ink no-underline hover:bg-orange-400">
          Ver todos los clubes
        </a>
      </section>
    ) : (
      <div class="py-8 space-y-12">
        <!-- HEADER PRINCIPAL DEL CLUB (Escudo grande + Ficha identitaria) -->
        <section class="card-vigor relative overflow-hidden border-t-2 border-t-gold-400 p-6 sm:p-8 bg-navy-950/80">
          <div class="flex flex-col md:flex-row md:items-center gap-6 lg:gap-10">
            <!-- Escudo en tamaño protagónico -->
            <div class="shrink-0 flex items-center justify-center p-3 bg-navy-900/40 border border-navy-800/80 shadow-2xl">
              <Escudo club={club} tam="2xl" />
            </div>

            <!-- Título y Datos de Ficha Rápida -->
            <div class="flex-1 space-y-3">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-orange-500 px-3 py-0.5 text-xs font-black uppercase tracking-wider text-ink shadow-sm">
                  Club Afiliado Oficial
                </span>
                {cultura?.apodo && (
                  <span class="text-xs font-bold uppercase tracking-wider text-gold-400">
                    «{cultura.apodo}»
                  </span>
                )}
              </div>

              <h1 class="m-0 text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-paper">
                {club.nombre}
              </h1>

              <p class="text-sm font-semibold uppercase tracking-wider text-paper/70">
                {cultura?.nombreOficial}
              </p>

              <!-- Grilla de datos técnicos del club (estilo wikipedia deportivo) -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t border-navy-800/80 text-xs">
                <div>
                  <span class="block text-[0.68rem] font-black uppercase tracking-wider text-paper/50">Fundación</span>
                  <strong class="font-bold text-paper">{cultura?.fundacion}</strong>
                </div>
                <div>
                  <span class="block text-[0.68rem] font-black uppercase tracking-wider text-paper/50">Ciudad / Sede</span>
                  <strong class="font-bold text-paper">{cultura?.ciudad}</strong>
                </div>
                <div>
                  <span class="block text-[0.68rem] font-black uppercase tracking-wider text-paper/50">Colores</span>
                  <strong class="font-bold text-paper">{cultura?.colores}</strong>
                </div>
                <div>
                  <span class="block text-[0.68rem] font-black uppercase tracking-wider text-paper/50">Gimnasio</span>
                  <strong class="font-bold text-paper truncate block" title={cultura?.gimnasioNombre}>
                    {club.gimnasio ?? cultura?.gimnasioNombre}
                  </strong>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- RESEÑA CULTURAL E HISTÓRICA (tipo wikipedia pero fina y descansada) -->
        {cultura && (
          <section class="card-vigor p-6 sm:p-8 bg-navy-950/60 border border-navy-700/70 space-y-4">
            <div class="flex items-center gap-2 border-b border-navy-800 pb-2.5">
              <span class="inline-block h-2 w-2 bg-gold-400"></span>
              <h2 class="m-0 text-sm sm:text-base font-black uppercase tracking-widest text-gold-400">
                Identidad, Tradición & Arraigo
              </h2>
            </div>
            <div class="space-y-3 text-paper/85 text-sm sm:text-base font-medium leading-relaxed max-w-4xl">
              <p class="m-0">
                {cultura.resena}
              </p>
              {cultura.hito && (
                <p class="m-0 text-xs sm:text-sm font-semibold text-paper/70 italic border-l-2 border-orange-500 pl-3 py-0.5">
                  «{cultura.hito}»
                </p>
              )}
            </div>
          </section>
        )}

        <!-- SECCIÓN DE PLANTELES Y FICHAS PLEGABLES POR CATEGORÍA -->
        <section class="space-y-4" aria-labelledby="t-planteles">
          <div class="flex items-baseline justify-between gap-4 border-b border-navy-700/60 pb-3">
            <div class="flex items-center gap-2.5">
              <span class="inline-block h-2.5 w-2.5 bg-orange-500"></span>
              <h2 id="t-planteles" class="m-0 text-xl sm:text-2xl font-black uppercase tracking-wide text-paper">
                Planteles & Fichas Oficiales
              </h2>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-paper/60">
              Temporada 2026
            </span>
          </div>

          {equipos.length === 0 ? (
            <p class="card-vigor border border-navy-700 bg-navy-950/60 p-6 text-center text-sm font-semibold text-paper/70">
              Equipos y planteles en proceso de homologación por secretaría.
            </p>
          ) : (
            <div class="space-y-3">
              {equipos.map((eq, idx) => {
                const fichas = (rosterPorEquipo.get(eq.id) ?? []).sort(
                  (a, b) => (a.dorsal ?? 99) - (b.dorsal ?? 99)
                );
                const abierta = idx === 0;

                return (
                  <details
                    open={abierta}
                    class="group/details card-vigor overflow-hidden border border-navy-700/80 bg-navy-950/70 transition-all duration-200"
                  >
                    <summary class="flex cursor-pointer items-center justify-between gap-3 p-4 sm:p-5 select-none bg-navy-900/40 hover:bg-navy-900/80 transition-colors list-none">
                      <div class="flex items-center gap-3">
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-navy-800 text-[0.7rem] font-black text-gold-400 border border-navy-700">
                          {idx + 1}
                        </span>
                        <h3 class="m-0 text-base sm:text-lg font-black uppercase tracking-wide text-paper group-hover/details:text-orange-400 transition-colors">
                          {eq.categorias?.nombre ?? 'Equipo'}
                        </h3>
                      </div>
                      <div class="flex items-center gap-3">
                        <span class="rounded-full bg-navy-950 border border-navy-700 px-3 py-0.5 text-xs font-black uppercase tracking-wider text-paper/75">
                          {fichas.length} {fichas.length === 1 ? 'Ficha' : 'Fichas'}
                        </span>
                        <svg
                          class="h-4 w-4 text-paper/60 transition-transform duration-200 group-open/details:rotate-180"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                      </div>
                    </summary>

                    <div class="p-4 sm:p-6 border-t border-navy-800/80 bg-navy-950/40">
                      {fichas.length === 0 ? (
                        <p class="py-4 text-center text-xs sm:text-sm font-semibold text-paper/60 italic">
                          Plantel a confirmar por el delegado del club.
                        </p>
                      ) : (
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
                          {fichas.map((f) => (
                            <JugadorFicha ficha={f} categoriaNombre={eq.categorias?.nombre} />
                          ))}
                        </div>
                      )}
                    </div>
                  </details>
                );
              })}
            </div>
          )}
        </section>

        <!-- CALENDARIO Y PARTIDOS DEL CLUB -->
        {porTorneo.length > 0 && (
          <section class="space-y-6 pt-4" aria-labelledby="t-calendario">
            <div class="flex items-baseline justify-between gap-4 border-b border-navy-700/60 pb-3">
              <div class="flex items-center gap-2.5">
                <span class="inline-block h-2.5 w-2.5 bg-gold-400"></span>
                <h2 id="t-calendario" class="m-0 text-xl sm:text-2xl font-black uppercase tracking-wide text-paper">
                  Fixture & Resultados de {club.nombre}
                </h2>
              </div>
            </div>

            <div class="space-y-8">
              {porTorneo.map(({ torneo, partidos }) => (
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <h3 class="m-0 text-base sm:text-lg font-black uppercase tracking-wide text-gold-400">
                      {torneo.nombre}
                    </h3>
                    <a
                      href={`/fixture?torneo=${torneo.id}`}
                      class="text-xs font-black uppercase tracking-wider text-orange-500 hover:text-orange-400 no-underline transition-colors"
                    >
                      Ver torneo completo &rarr;
                    </a>
                  </div>
                  <div class="grid gap-2.5">
                    {partidos.map((p) => (
                      <PartidoFila partido={p} />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    )
  }
</Base>
