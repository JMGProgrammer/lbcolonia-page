const tema: TemaClub = (club?.slug && TEMAS_CLUBES[club.slug]) || TEMAS_CLUBES['plaza-colonia'];
---

<Base
  title={club ? `${club.nombre} · Club Oficial LBC` : 'Club'}
  description={club ? `${cultura?.nombreOficial ?? club.nombre} en la Liga de Básquetbol de Colonia: historia, identidad, planteles y fixture oficial.` : 'Club de la LBC.'}
>
  {
    !club ? (
      <section class="py-20 text-center">
        <h1 class="text-2xl font-black text-paper">Club no encontrado</h1>
        <p class="mt-2 text-paper-muted">No encontramos el club solicitado en los registros oficiales.</p>
        <a href="/clubes" class="mt-6 inline-block bg-orange-500 px-6 py-2.5 text-xs font-black uppercase tracking-wider text-ink no-underline hover:bg-orange-400">
          Ver todos los clubes
        </a>
      </section>
    ) : (
      <div class="py-8 space-y-12">
        <!-- HEADER PRINCIPAL DEL CLUB (Escudo grande + Ficha identitaria) -->
        <section class={`card-vigor relative overflow-hidden border ${tema.heroBorder} ${tema.heroBg} p-6 sm:p-8 shadow-2xl`}>
          <!-- Ribete superior con la enseña del club -->
          <div class={`absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r ${tema.heroRibete}`} aria-hidden="true"></div>

          <div class="flex flex-col md:flex-row md:items-center gap-6 lg:gap-10 pt-1">
            <!-- Escudo en tamaño protagónico -->
            <div class={`shrink-0 flex items-center justify-center p-3.5 ${tema.heroEscudoBg} border shadow-2xl`}>
              <Escudo club={club} tam="2xl" />
            </div>

            <!-- Título y Datos de Ficha Rápida -->
            <div class="flex-1 space-y-3">
              <div class="flex flex-wrap items-center gap-2">
                <span class={`rounded-full ${tema.badgeClub} px-3 py-0.5 text-xs font-black uppercase tracking-wider shadow-sm`}>
                  Club Afiliado Oficial
                </span>
                {cultura?.apodo && (
                  <span class={`text-xs font-bold uppercase tracking-wider ${tema.apodoColor}`}>
                    «{cultura.apodo}»
                  </span>
                )}
              </div>

              <h1 class="m-0 text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-paper">
                {club.nombre}
              </h1>

              <p class="text-sm font-semibold uppercase tracking-wider text-paper/75">
                {cultura?.nombreOficial}
              </p>

              <!-- Grilla de datos técnicos del club (estilo enciclopédico deportivo) -->
              <div class={`grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t ${tema.statsBorder} text-xs`}>
                <div>
                  <span class={`block text-[0.68rem] font-black uppercase tracking-wider ${tema.statsLabel}`}>Fundación</span>
                  <strong class="font-bold text-paper">{cultura?.fundacion}</strong>
                </div>
                <div>
                  <span class={`block text-[0.68rem] font-black uppercase tracking-wider ${tema.statsLabel}`}>Ciudad / Sede</span>
                  <strong class="font-bold text-paper">{cultura?.ciudad}</strong>
                </div>
                <div>
                  <span class={`block text-[0.68rem] font-black uppercase tracking-wider ${tema.statsLabel}`}>Colores</span>
                  <strong class="font-bold text-paper">{cultura?.colores}</strong>
                </div>
                <div>
                  <span class={`block text-[0.68rem] font-black uppercase tracking-wider ${tema.statsLabel}`}>Gimnasio</span>
                  <strong class="font-bold text-paper truncate block" title={cultura?.gimnasioNombre}>
                    {club.gimnasio ?? cultura?.gimnasioNombre}
                  </strong>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- RESEÑA CULTURAL E HISTÓRICA (con tonalidad complementaria propia del club) -->
        {cultura && (
          <section class={`card-vigor p-6 sm:p-8 ${tema.resenaBg} border ${tema.resenaBorder} space-y-4 shadow-xl`}>
            <div class={`flex items-center gap-2 border-b ${tema.resenaBorderB} pb-2.5`}>
              <span class={`inline-block h-2.5 w-2.5 ${tema.resenaIndicador}`}></span>
              <h2 class={`m-0 text-sm sm:text-base font-black uppercase tracking-widest ${tema.resenaTitulo}`}>
                Identidad, Tradición & Arraigo
              </h2>
            </div>
            <div class="space-y-3 text-paper/90 text-sm sm:text-base font-medium leading-relaxed max-w-4xl">
              <p class="m-0">
                {cultura.resena}
              </p>
              {cultura.hito && (
                <p class={`m-0 text-xs sm:text-sm font-semibold text-paper/80 italic border-l-2 ${tema.resenaHitoBorder} pl-3 py-1 bg-black/20`}>
                  «{cultura.hito}»
                </p>
              )}
            </div>
          </section>
        )}

        <!-- SECCIÓN DE PLANTELES Y FICHAS PLEGABLES POR CATEGORÍA -->
        <section class="space-y-4" aria-labelledby="t-planteles">
          <div class="flex items-baseline justify-between gap-4 border-b border-navy-700/60 pb-3">
            <div class="flex items-center gap-2.5">
              <span class={`inline-block h-2.5 w-2.5 ${tema.plantelIndicador}`}></span>
              <h2 id="t-planteles" class="m-0 text-xl sm:text-2xl font-black uppercase tracking-wide text-paper">
                Planteles & Fichas Oficiales
              </h2>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-paper/60">
              Temporada 2026
            </span>
          </div>

          {equipos.length === 0 ? (
            <p class="card-vigor border border-navy-700 bg-navy-950/60 p-6 text-center text-sm font-semibold text-paper/70">
              Equipos y planteles en proceso de homologación por secretaría.
            </p>
          ) : (
            <div class="space-y-3">
              {equipos.map((eq, idx) => {
                const fichas = (rosterPorEquipo.get(eq.id) ?? []).sort(
                  (a, b) => (a.dorsal ?? 99) - (b.dorsal ?? 99)
                );
                const abierta = idx === 0;

                return (
                  <details
                    open={abierta}
                    class={`group/details card-vigor overflow-hidden border ${tema.accordionBorder} ${tema.accordionBg} transition-all duration-200 shadow-md`}
                  >
                    <summary class={`flex cursor-pointer items-center justify-between gap-3 p-4 sm:p-5 select-none ${tema.accordionSummary} transition-colors list-none`}>
                      <div class="flex items-center gap-3">
                        <span class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-full ${tema.accordionNum} text-[0.7rem] font-black border`}>
                          {idx + 1}
                        </span>
                        <h3 class={`m-0 text-base sm:text-lg font-black uppercase tracking-wide text-paper ${tema.accordionTitleHover} transition-colors`}>
                          {eq.categorias?.nombre ?? 'Equipo'}
                        </h3>
                      </div>
                      <div class="flex items-center gap-3">
                        <span class={`rounded-full ${tema.accordionBadge} border px-3 py-0.5 text-xs font-black uppercase tracking-wider`}>
                          {fichas.length} {fichas.length === 1 ? 'Ficha' : 'Fichas'}
                        </span>
                        <svg
                          class="h-4 w-4 text-paper/60 transition-transform duration-200 group-open/details:rotate-180"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                      </div>
                    </summary>

                    <div class={`p-4 sm:p-6 border-t ${tema.accordionInteriorBg}`}>
                      {fichas.length === 0 ? (
                        <p class="py-4 text-center text-xs sm:text-sm font-semibold text-paper/60 italic">
                          Plantel a confirmar por el delegado del club.
                        </p>
                      ) : (
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
                          {fichas.map((f) => (
                            <JugadorFicha
                              ficha={f}
                              categoriaNombre={eq.categorias?.nombre}
                              themeBorder={tema.fichaBorder}
                              themeBg={tema.fichaBg}
                              themeDorsal={tema.fichaDorsal}
                              themeHoverBorder={tema.fichaHoverBorder}
                            />
                          ))}
                        </div>
                      )}
                    </div>
                  </details>
                );
              })}
            </div>
          )}
        </section>

        <!-- CALENDARIO Y PARTIDOS DEL CLUB -->
        {porTorneo.length > 0 && (
          <section class="space-y-6 pt-4" aria-labelledby="t-calendario">
            <div class="flex items-baseline justify-between gap-4 border-b border-navy-700/60 pb-3">
              <div class="flex items-center gap-2.5">
                <span class={`inline-block h-2.5 w-2.5 ${tema.fixtureIndicador}`}></span>
                <h2 id="t-calendario" class="m-0 text-xl sm:text-2xl font-black uppercase tracking-wide text-paper">
                  Fixture & Resultados de {club.nombre}
                </h2>
              </div>
            </div>

            <div class="space-y-8">
              {porTorneo.map(({ torneo, partidos }) => (
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <h3 class={`m-0 text-base sm:text-lg font-black uppercase tracking-wide ${tema.fixtureTorneoTitle}`}>
                      {torneo.nombre}
                    </h3>
                    <a
                      href={`/fixture?torneo=${torneo.id}`}
                      class={`text-xs font-black uppercase tracking-wider ${tema.fixtureLink} no-underline transition-colors`}
                    >
                      Ver torneo completo &rarr;
                    </a>
                  </div>
                  <div class="grid gap-2.5">
                    {partidos.map((p) => (
                      <PartidoFila partido={p} />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    )
  }
</Base>
