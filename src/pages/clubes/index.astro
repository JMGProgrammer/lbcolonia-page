---
// Directorio de clubes activos de la org (Docs/04 §1).
import Base from '../../layouts/Base.astro';
import Rotulo from '../../components/Rotulo.astro';
import Escudo from '../../components/Escudo.astro';
import { listarClubes } from '../../lib/data';

const clubes = await listarClubes();
---

<Base title="Clubes" description="Los clubes de la Liga de Básquetbol de Colonia: equipos, gimnasios y fichas por competencia.">
  <section class="py-8">
    <h1 class="text-2xl font-black lg:text-3xl">Clubes</h1>
    <p class="mt-1 text-sm text-paper-muted">Los clubes que forman la liga esta temporada.</p>
    {
      clubes.length === 0 ? (
        <p class="mt-8 card-vigor p-8 text-center text-paper-muted">
          Información de clubes a publicarse pronto.
        </p>
      ) : (
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {clubes.map((c) => (
            <a
              href={`/clubes/${c.slug}`}
              class="card-vigor group flex flex-col items-center justify-between p-6 text-center no-underline transition-all duration-300 hover:border-orange-500/60 hover:-translate-y-1 hover:shadow-2xl"
            >
              <div class="flex flex-col items-center gap-4">
                <div class="flex h-24 w-24 items-center justify-center transition-transform duration-300 group-hover:scale-105">
                  <Escudo club={c} tam="xl" />
                </div>
                <div>
                  <h2 class="text-xl font-black text-paper group-hover:text-orange-400 transition-colors">{c.nombre}</h2>
                  {c.gimnasio && <p class="mt-2 line-clamp-2 text-xs font-semibold text-paper/70">{c.gimnasio}</p>}
                </div>
              </div>
              <div class="mt-5 w-full border-t border-navy-800/80 pt-3">
                <span class="text-xs font-black uppercase tracking-wider text-orange-500 group-hover:text-orange-400 transition-colors">
                  Ver plantel y fixture &rarr;
                </span>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Base>
