---
// Home: marcador del fin de semana + próxima fecha + noticias + tabla + próximos + auspiciantes.
// RLS: solo partidos/torneos visible para anon; los resultados aparecen solo si están publicados.
import Base from '../layouts/Base.astro';
import Rotulo from '../components/Rotulo.astro';
import Panel from '../components/Panel.astro';
import Btn from '../components/Btn.astro';
import ResultCard from '../components/ResultCard.astro';
import PartidoFila from '../components/PartidoFila.astro';
import TablaPosiciones from '../components/TablaPosiciones.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import AuspicianteTile from '../components/AuspicianteTile.astro';
import Escudo from '../components/Escudo.astro';
import {
  listarTorneos,
  listarPartidosDeTorneo,
  tablaDeTorneo,
  listarNoticias,
  listarAuspiciantes,
  listarPaginas,
  listarClubes,
  torneoPorDefecto,
} from '../lib/data';
import type { PartidoVista } from '../lib/data';
import { fechaCorta, horaCorta, rondaLabel } from '../lib/fmt';

const [torneos, noticias, auspiciantes, paginas, clubes] = await Promise.all([
  listarTorneos(),
  listarNoticias(4),
  listarAuspiciantes(),
  listarPaginas(),
  listarClubes(),
]);

const primera = torneoPorDefecto(torneos);
const partidos = primera ? await listarPartidosDeTorneo(primera.id) : [];
const tabla = primera ? await tablaDeTorneo(primera.id) : [];

const publicados = partidos.filter((p) => p.publicado && (p.estado === 'finalizado' || p.estado === 'walkover'));
publicados.sort((a, b) => new Date(b.fecha_hora).getTime() - new Date(a.fecha_hora).getTime());
const rondaPublicada = publicados[0]?.ronda ?? null;
const fechaPublicada = partidos
  .filter((p) => p.ronda === rondaPublicada)
  .sort((a, b) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime());

const vivos = partidos.filter((p) => p.estado === 'programado' || p.estado === 'postergado' || p.estado === 'suspendido' || p.estado === 'en_juego');
const vivosFuturos = vivos.filter((p) => new Date(p.fecha_hora).getTime() >= Date.now() - 2 * 60 * 60 * 1000);
const programados = vivosFuturos.length > 0 ? vivosFuturos : vivos;
programados.sort((a, b) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime());

const rondaProxima = programados[0]?.ronda ?? null;
const fechaProxima = partidos.filter((p) => p.ronda === rondaProxima).sort((a, b) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime());

const rondasListadas = [...new Set(programados.map((p) => p.ronda))].slice(0, 2);
const proximosListado = programados.filter((p) => rondasListadas.includes(p.ronda));

/* JSON-LD: SportsEvent por partido con sede y equipos (Docs/04 §3) */
const eventosLd = [...publicados, ...fechaProxima]
  .filter((p) => p.local && p.visitante)
  .slice(0, 6)
  .map((p: PartidoVista) => ({
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: `${p.local!.clubes.nombre} vs ${p.visitante!.clubes.nombre}`,
    startDate: p.fecha_hora,
    sport: 'basketball',
    location: { '@type': 'Place', name: p.sede ?? 'Sede a confirmar' },
    competitor: [
      { '@type': 'SportsTeam', name: p.local!.clubes.nombre },
      { '@type': 'SportsTeam', name: p.visitante!.clubes.nombre },
    ],
  }));

const cabeceraNoticias = 'flex flex-wrap items-baseline justify-between gap-4 mb-5 border-b border-navy-700/60 pb-3';
const h2seccion = 'm-0 text-xl sm:text-2xl font-black uppercase tracking-wide text-paper flex items-center gap-2';
const linkmas = 'text-xs sm:text-sm font-black uppercase tracking-wider text-orange-500 hover:text-orange-400 no-underline transition-colors';
---

<Base>
  <section class="py-8 sm:py-10" aria-labelledby="rotulo-hero">
    <div class="mb-4">
      <Rotulo id="rotulo-hero">
        {
          primera
            ? `${primera.nombre} · ${rondaPublicada ? `${rondaLabel(rondaPublicada)} · ${fechaCorta(fechaPublicada[0].fecha_hora)}` : 'sin resultados aún'}`
            : 'Liga de Básquetbol de Colonia'
        }
      </Rotulo>
    </div>
    <div class="grid gap-5 md:grid-cols-[2fr_1fr] md:items-stretch">
      <div>
        <div class="grid gap-3.5">
          {
            fechaPublicada.length === 0 && (
              <Panel>
                <p class="py-6 text-center text-base font-semibold text-paper-muted">Aún no hay resultados publicados de esta competencia.</p>
              </Panel>
            )
          }
          {fechaPublicada.map((p) => <ResultCard partido={p} />)}
        </div>
      </div>
      {
        rondaProxima && (
          <Panel variante="dorado">
            <div class="flex items-center justify-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-gold-400 animate-pulse"></span>
              <p class="text-center text-xs font-black uppercase tracking-widest text-gold-400">Próxima fecha</p>
            </div>
            <h2 class="mt-1 text-center text-lg sm:text-xl font-black tracking-tight text-paper">
              {rondaLabel(rondaProxima)} · {fechaCorta(fechaProxima[0].fecha_hora)}
            </h2>
            <div class="mt-4 grid gap-2.5 rounded-lg bg-navy-950/70 p-3.5 border border-gold-400/20">
              {
                fechaProxima.map((p) => (
                  <p class="num flex items-center justify-center gap-2 text-center text-sm sm:text-base font-bold text-paper">
                    <span class="text-gold-400 font-extrabold">{horaCorta(p.fecha_hora)}</span>
                    <span class="num text-paper-muted">·</span>
                    <span class="truncate">
                      {p.local?.clubes.nombre} vs {p.visitante?.clubes.nombre}
                    </span>
                  </p>
                ))
              }
              <p class="mt-1 text-center text-xs font-semibold text-paper/70 border-t border-navy-800/80 pt-2">{fechaProxima[0].sede ?? 'Sede a confirmar'}</p>
            </div>
            <div class="mt-5 text-center">
              <Btn href={`/fixture?torneo=${primera?.id ?? ''}&ronda=${rondaProxima}`}>Ver fixture completo</Btn>
            </div>
          </Panel>
        )
      }
    </div>
  </section>

  {
    noticias.length > 0 && (
      <section class="pb-12 pt-2" aria-labelledby="t-noticias">
        <div class={cabeceraNoticias}>
          <div class="flex items-center gap-3">
            <span class="inline-block h-2 w-2 rounded-full bg-orange-500"></span>
            <h2 id="t-noticias" class={h2seccion}>
              Actualidad y Noticias
            </h2>
          </div>
          <a href="/noticias" class={linkmas}>
            Ver todas las noticias &rarr;
          </a>
        </div>

        <div class="space-y-4">
          <NoticiaCard noticia={noticias[0]} variante="destacada" />

          {noticias.length > 1 && (
            <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
              {noticias.slice(1, 4).map((n) => (
                <NoticiaCard noticia={n} variante="horizontal" />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    clubes.length > 0 && (
      <section class="pb-12" aria-labelledby="t-clubes-liga">
        <div class={cabeceraNoticias}>
          <div class="flex items-center gap-3">
            <span class="inline-block h-2 w-2 rounded-full bg-gold-400"></span>
            <h2 id="t-clubes-liga" class={h2seccion}>
              Clubes Afiliados
            </h2>
          </div>
          <a href="/clubes" class={linkmas}>
            Ver todos los clubes &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {clubes.map((c) => (
            <a
              href={`/clubes/${c.slug}`}
              class="card-vigor group flex flex-col items-center justify-center p-4 text-center no-underline transition-all duration-200 hover:border-orange-500/60 hover:-translate-y-1 hover:shadow-xl"
            >
              <div class="flex h-16 w-16 items-center justify-center transition-transform duration-300 group-hover:scale-110">
                <Escudo club={c} tam="lg" />
              </div>
              <span class="mt-2.5 line-clamp-1 text-xs font-black uppercase tracking-wider text-paper group-hover:text-orange-400 transition-colors">
                {c.nombre}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="pb-10" aria-labelledby="t-tabla">
    <div class={cabeceraNoticias}>
      <h2 id="t-tabla" class={h2seccion}>
        Tabla de posiciones
      </h2>
      <a href={primera ? `/tabla?torneo=${primera.id}` : '/tabla'} class={linkmas}>
        Ver tabla completa →
      </a>
    </div>
    <TablaPosiciones filas={tabla} caption={`Posiciones de ${primera?.nombre ?? 'la competencia'}`} />
  </section>

  {
    rondasListadas.length > 0 && (
      <section class="pb-10" aria-labelledby="t-fixture">
        <div class={cabeceraNoticias}>
          <h2 id="t-fixture" class={h2seccion}>
            Próximos partidos
          </h2>
          <a href={primera ? `/fixture?torneo=${primera.id}` : '/fixture'} class={linkmas}>
            Fixture completo →
          </a>
        </div>
        <div class="flex flex-wrap gap-2.5 pb-4">
          {
            rondasListadas.map((r) => (
              <a
                href={`/fixture?torneo=${primera?.id ?? ''}&ronda=${r}`}
                class="rounded-full border border-navy-700 px-4 py-1.5 text-[0.8rem] font-bold uppercase tracking-[0.09em] text-paper-muted no-underline transition-colors hover:border-orange-500 hover:text-paper"
              >
                {rondaLabel(r)}
              </a>
            ))
          }
        </div>
        <div class="grid gap-3">
          {proximosListado.map((p) => (
            <PartidoFila partido={p} />
          ))}
        </div>
      </section>
    )
  }

  <section class="pb-10" aria-labelledby="t-competencias">
    <div class={cabeceraNoticias}>
      <h2 id="t-competencias" class={h2seccion}>
        Competencias
      </h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        torneos.map((t) => (
          <Panel>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded bg-navy-950/80 px-2 py-0.5 text-xs font-black uppercase tracking-wider text-gold-400 border border-navy-800">
                {t.categorias?.nombre}
              </span>
              <span class="text-xs font-bold uppercase tracking-wider text-paper/70">
                {t.estado === 'en_curso' ? 'En curso' : t.estado === 'proximo' ? 'Próximo' : 'Finalizado'}
              </span>
            </div>
            <h3 class="mt-2 text-base sm:text-lg font-black leading-tight text-paper">{t.nombre}</h3>
            <div class="mt-4 flex gap-2">
              <a href={`/fixture?torneo=${t.id}`} class="flex-1 text-center rounded-lg bg-navy-800/90 border border-navy-700 px-3 py-2 text-xs font-bold uppercase tracking-wider no-underline transition-all hover:border-orange-500 hover:bg-orange-500 hover:text-ink">
                Fixture
              </a>
              <a href={`/tabla?torneo=${t.id}`} class="flex-1 text-center rounded-lg bg-navy-800/90 border border-navy-700 px-3 py-2 text-xs font-bold uppercase tracking-wider no-underline transition-all hover:border-gold-400 hover:bg-gold-400 hover:text-ink">
                Tabla
              </a>
            </div>
          </Panel>
        ))
      }
    </div>
  </section>

  {
    paginas.length > 0 && (
      <section class="pb-10" aria-labelledby="t-institucional">
        <div class={cabeceraNoticias}>
          <h2 id="t-institucional" class={h2seccion}>
            Institucional
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            paginas.map((p) => (
              <a href={`/${p.slug}`} class="card-vigor p-5 sm:p-6 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-orange-500/50">
                <h3 class="m-0 mb-1.5 text-lg font-black text-paper">{p.titulo}</h3>
                <p class="m-0 text-sm font-medium text-paper/80 leading-relaxed">{p.slug === 'reglamento' ? 'Formato del torneo, sistema de puntos y disciplina.' : 'Oficina, horarios y redes de la liga.'}</p>
              </a>
            ))
          }
        </div>
      </section>
    )
  }

  {
    auspiciantes.length > 0 && (
      <section class="pb-4" aria-labelledby="t-auspicios">
        <div class={cabeceraNoticias}>
          <h2 id="t-auspicios" class={h2seccion}>
            Auspician la LBC
          </h2>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {auspiciantes.map((a) => (
            <AuspicianteTile a={a} />
          ))}
        </div>
      </section>
    )
  }

  {
    eventosLd.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(eventosLd)} />
    )
  }
</Base>
