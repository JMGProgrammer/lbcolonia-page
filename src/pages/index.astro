---
// Home: marcador del fin de semana + próxima fecha + noticias + tabla + próximos + auspiciantes.
// RLS: solo partidos/torneos visible para anon; los resultados aparecen solo si están publicados.
import Base from '../layouts/Base.astro';
import Rotulo from '../components/Rotulo.astro';
import Panel from '../components/Panel.astro';
import ResultCard from '../components/ResultCard.astro';
import TablaPosiciones from '../components/TablaPosiciones.astro';
import NavegadorFechas from '../components/NavegadorFechas.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import Escudo from '../components/Escudo.astro';
import AficheProximaFecha from '../components/AficheProximaFecha.astro';
import {
  listarTorneos,
  listarPartidosDeTorneo,
  tablaDeTorneo,
  listarNoticias,
  listarPaginas,
  listarClubes,
  torneoPorDefecto,
} from '../lib/data';
import type { PartidoVista } from '../lib/data';
import { fechaCorta, rondaLabel } from '../lib/fmt';

const [torneos, noticias, paginas, clubes] = await Promise.all([
  listarTorneos(),
  listarNoticias(4),
  listarPaginas(),
  listarClubes(),
]);

const primera = torneoPorDefecto(torneos);
const partidos = primera ? await listarPartidosDeTorneo(primera.id) : [];
const tabla = primera ? await tablaDeTorneo(primera.id) : [];

const publicados = partidos.filter((p) => p.publicado && (p.estado === 'finalizado' || p.estado === 'walkover'));
publicados.sort((a, b) => new Date(b.fecha_hora).getTime() - new Date(a.fecha_hora).getTime());
const rondaPublicada = publicados[0]?.ronda ?? null;
const fechaPublicada = partidos
  .filter((p) => p.ronda === rondaPublicada)
  .sort((a, b) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime());

const vivos = partidos.filter((p) => p.estado === 'programado' || p.estado === 'postergado' || p.estado === 'suspendido' || p.estado === 'en_juego');
const vivosFuturos = vivos.filter((p) => new Date(p.fecha_hora).getTime() >= Date.now() - 2 * 60 * 60 * 1000);
const programados = vivosFuturos.length > 0 ? vivosFuturos : vivos;
programados.sort((a, b) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime());

const rondaProxima = programados[0]?.ronda ?? null;
const fechaProxima = partidos.filter((p) => p.ronda === rondaProxima).sort((a, b) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime());

/* JSON-LD: SportsEvent por partido con sede y equipos (Docs/04 §3) */
const eventosLd = [...publicados, ...fechaProxima]
  .filter((p) => p.local && p.visitante)
  .slice(0, 6)
  .map((p: PartidoVista) => ({
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: `${p.local!.clubes.nombre} vs ${p.visitante!.clubes.nombre}`,
    startDate: p.fecha_hora,
    sport: 'basketball',
    location: { '@type': 'Place', name: p.sede ?? 'Sede a confirmar' },
    competitor: [
      { '@type': 'SportsTeam', name: p.local!.clubes.nombre },
      { '@type': 'SportsTeam', name: p.visitante!.clubes.nombre },
    ],
  }));

const cabeceraNoticias = 'flex flex-wrap items-baseline justify-between gap-4 mb-5 border-b border-navy-700/60 pb-3';
const h2seccion = 'm-0 text-xl sm:text-2xl font-black uppercase tracking-wide text-paper flex items-center gap-2';
const linkmas = 'text-xs sm:text-sm font-black uppercase tracking-wider text-orange-500 hover:text-orange-400 no-underline transition-colors';

/* Competencias: Primera aparte, Formativas agrupadas (U22 … U10, ya ordenadas por categoría) */
const formativas = torneos.filter((t) => t.id !== primera?.id && /^U\d+/i.test(t.categorias?.nombre ?? ''));
const anioTemporada = primera?.temporada ?? new Date().getFullYear();
const estadoTxt = (e: string) => (e === 'en_curso' ? 'En curso' : e === 'proximo' ? 'Próximo' : 'Finalizado');
const btnComp =
  'flex-1 rounded-full border border-navy-600 bg-navy-900/90 px-3 py-2 text-center text-xs font-black uppercase tracking-wider text-paper no-underline transition-all hover:border-orange-500 hover:bg-orange-500 hover:text-ink shadow-sm';

const sponsorsOficiales = [
  {
    nombre: 'Montes del Plata',
    logo: '/images/sponsors/sponsor-montes-del-plata.png',
    categoria: 'Sponsor Principal',
  },
  {
    nombre: 'Pepsi',
    logo: '/images/sponsors/sponsor-pepsi.webp',
    categoria: 'Bebida Oficial',
  },
  {
    nombre: 'Turil',
    logo: '/images/sponsors/sponsor-turil.png',
    categoria: 'Transporte Oficial',
  },
  {
    nombre: 'Los Muchachos',
    logo: '/images/sponsors/sponsor-los-muchachos.png',
    categoria: 'Auspiciante Oficial',
  },
];
---

<Base>
  <section class="py-8 sm:py-10" aria-labelledby="rotulo-hero">
    <div class="mb-4">
      <Rotulo id="rotulo-hero">
        {
          primera
            ? `${primera.nombre} · ${rondaPublicada ? `${rondaLabel(rondaPublicada)} · ${fechaCorta(fechaPublicada[0].fecha_hora)}` : 'sin resultados aún'}`
            : 'Liga de Básquetbol de Colonia'
        }
      </Rotulo>
    </div>
    <div class="grid gap-6 lg:grid-cols-12 lg:items-stretch">
      <div class="lg:col-span-7 flex flex-col justify-between">
        <div class="grid gap-3.5">
          {
            fechaPublicada.length === 0 && (
              <Panel>
                <p class="py-6 text-center text-base font-semibold text-paper-muted">Aún no hay resultados publicados de esta competencia.</p>
              </Panel>
            )
          }
          {fechaPublicada.map((p) => <ResultCard partido={p} />)}
        </div>
      </div>
      {
        rondaProxima && (
          <div class="lg:col-span-5 flex flex-col">
            <AficheProximaFecha ronda={rondaProxima} partidos={fechaProxima} torneoId={primera?.id} competencia={primera?.nombre} />
          </div>
        )
      }
    </div>
  </section>

  <!-- SPONSORS OFICIALES DE LA LIGA (Ubicados antes de Actualidad y Noticias) -->
  <section class="pb-10 pt-1" aria-labelledby="t-sponsors-home">
    <div class="card-vigor overflow-hidden border border-navy-700/80 bg-navy-950/75 p-5 sm:p-6 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3.5 border-b border-navy-800">
        <div class="flex items-center gap-2.5">
          <span class="inline-block h-2 w-2 rounded-full bg-gold-400"></span>
          <h2 id="t-sponsors-home" class="m-0 text-xs sm:text-sm font-black uppercase tracking-widest text-gold-400">
            Sponsors Oficiales · Liga de Básquetbol de Colonia
          </h2>
        </div>
        <span class="text-[0.68rem] font-bold uppercase tracking-wider text-paper/50">
          Temporada 2026
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 sm:gap-4 pt-4">
        {sponsorsOficiales.map((s) => (
          <div
            title={s.nombre}
            class="group relative flex h-20 sm:h-24 items-center justify-center rounded-xl border border-navy-700/60 bg-white/95 p-3.5 sm:p-4 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-orange-500 hover:shadow-[0_8px_24px_rgba(238,107,31,0.25)]"
          >
            <img
              src={s.logo}
              alt={`Logo de ${s.nombre}`}
              loading="lazy"
              class="max-h-full max-w-full object-contain filter contrast-105 transition-transform duration-300 group-hover:scale-105"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {
    noticias.length > 0 && (
      <section class="pb-12 pt-2" aria-labelledby="t-noticias">
        <div class={cabeceraNoticias}>
          <div class="flex items-center gap-3">
            <span class="inline-block h-2 w-2 rounded-full bg-orange-500"></span>
            <h2 id="t-noticias" class={h2seccion}>
              Actualidad y Noticias
            </h2>
          </div>
          <a href="/noticias" class={linkmas}>
            Ver todas las noticias &rarr;
          </a>
        </div>

        <NoticiaCard noticia={noticias[0]} variante="destacada">
          {noticias.length > 1 && (
            <div class="mt-auto border-t border-navy-700/60 pt-4">
              <p class="m-0 mb-1 text-[0.7rem] font-black uppercase tracking-widest text-paper/60">Más noticias</p>
              {noticias.slice(1, 4).map((n) => (
                <NoticiaCard noticia={n} variante="mini" />
              ))}
            </div>
          )}
        </NoticiaCard>
      </section>
    )
  }

  {
    clubes.length > 0 && (
      <section class="pb-12" aria-labelledby="t-clubes-liga">
        <div class={cabeceraNoticias}>
          <div class="flex items-center gap-3">
            <span class="inline-block h-2 w-2 rounded-full bg-gold-400"></span>
            <h2 id="t-clubes-liga" class={h2seccion}>
              Clubes Afiliados
            </h2>
          </div>
          <a href="/clubes" class={linkmas}>
            Ver todos los clubes &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-4">
          {clubes.map((c) => {
            const estilo = (
              c.slug === 'plaza-colonia'
                ? {
                    bgSolido: 'bg-[#0B482A]',
                    borde: 'border-emerald-400/40 hover:border-emerald-300 group-hover:shadow-[0_12px_32px_rgba(16,185,129,0.3)]',
                    ribete: 'from-emerald-300 via-white to-emerald-400',
                    ondaColor: 'bg-emerald-400/15',
                    ondaColor2: 'bg-white/10',
                    hoverText: 'group-hover:text-emerald-200',
                  }
                : c.slug === 'colonia-rowing'
                ? {
                    bgSolido: 'bg-[#031022]',
                    borde: 'border-blue-500/35 hover:border-blue-400 group-hover:shadow-[0_12px_32px_rgba(29,78,216,0.45)]',
                    ribete: 'from-blue-700 via-white to-blue-500',
                    ondaColor: 'bg-blue-600/15',
                    ondaColor2: 'bg-white/10',
                    hoverText: 'group-hover:text-blue-200',
                  }
                : c.slug === 'estudiantes-el-colla'
                ? {
                    bgSolido: 'bg-[#7A1C1C]',
                    borde: 'border-amber-400/40 hover:border-amber-300 group-hover:shadow-[0_12px_32px_rgba(245,158,11,0.3)]',
                    ribete: 'from-red-500 via-amber-400 to-emerald-400',
                    ondaColor: 'bg-amber-400/15',
                    ondaColor2: 'bg-red-400/10',
                    hoverText: 'group-hover:text-amber-200',
                  }
                : c.slug === 'juventud-caj'
                ? {
                    bgSolido: 'bg-[#142852]',
                    borde: 'border-red-500/40 hover:border-red-400 group-hover:shadow-[0_12px_32px_rgba(239,68,68,0.3)]',
                    ribete: 'from-red-500 via-blue-500 to-red-500',
                    ondaColor: 'bg-red-500/15',
                    ondaColor2: 'bg-blue-400/10',
                    hoverText: 'group-hover:text-red-200',
                  }
                : {
                    // cac-valdense y otros
                    bgSolido: 'bg-[#0F4775]',
                    borde: 'border-sky-300/40 hover:border-sky-200 group-hover:shadow-[0_12px_32px_rgba(125,211,252,0.3)]',
                    ribete: 'from-sky-300 via-white to-sky-400',
                    ondaColor: 'bg-sky-300/15',
                    ondaColor2: 'bg-white/10',
                    hoverText: 'group-hover:text-sky-200',
                  }
            );

            return (
              <a
                href={`/clubes/${c.slug}`}
                class={`group relative flex flex-col items-center justify-between overflow-hidden rounded-2xl border ${estilo.bgSolido} ${estilo.borde} p-5 text-center no-underline transition-all duration-300 hover:-translate-y-1.5`}
              >
                <!-- Ribete superior con los colores representativos -->
                <div class={`absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r ${estilo.ribete}`} aria-hidden="true"></div>

                <!-- Animación de Ola Fluida (Smooth Wave Animation) en el Hover -->
                <div
                  class={`pointer-events-none absolute -bottom-[160%] -left-[50%] h-[240%] w-[200%] rounded-[42%] ${estilo.ondaColor} transition-transform duration-700 ease-out group-hover:-translate-y-[52%] group-hover:rotate-[190deg]`}
                  aria-hidden="true"
                ></div>
                <div
                  class={`pointer-events-none absolute -bottom-[150%] -left-[45%] h-[230%] w-[190%] rounded-[40%] ${estilo.ondaColor2} transition-transform duration-1000 ease-out delay-75 group-hover:-translate-y-[48%] group-hover:rotate-[140deg]`}
                  aria-hidden="true"
                ></div>

                <!-- Escudo protagonista sin marcos artificiales -->
                <div class="relative z-10 flex h-20 w-20 items-center justify-center transition-transform duration-300 group-hover:scale-110 drop-shadow-lg">
                  <Escudo club={c} tam="lg" />
                </div>

                <!-- Nombre del club con tag redondeado -->
                <div class="relative z-10 mt-3 flex flex-col items-center">
                  <span class={`text-xs sm:text-sm font-black uppercase tracking-tight text-paper transition-colors duration-200 ${estilo.hoverText}`}>
                    {c.nombre}
                  </span>
                  <span class="mt-1.5 inline-flex items-center gap-1 rounded-full bg-black/40 border border-white/15 px-2.5 py-0.5 text-[0.62rem] font-bold uppercase tracking-wider text-paper/80 group-hover:border-white/30 group-hover:text-paper transition-all">
                    Ver club &rarr;
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="pb-10" aria-labelledby="t-tabla">
    <div class={cabeceraNoticias}>
      <h2 id="t-tabla" class={h2seccion}>
        Tabla de posiciones
      </h2>
      <a href={primera ? `/tabla?torneo=${primera.id}` : '/tabla'} class={linkmas}>
        Ver tabla completa →
      </a>
    </div>
    <TablaPosiciones filas={tabla} caption={`Posiciones de ${primera?.nombre ?? 'la competencia'}`} />

    {partidos.length > 0 && (
      <div class="mt-8">
        <NavegadorFechas partidos={partidos} torneoNombre={primera?.nombre} torneoId={primera?.id} />
      </div>
    )}
  </section>

  <section class="pb-10" aria-labelledby="t-competencias">
    <div class={cabeceraNoticias}>
      <h2 id="t-competencias" class={h2seccion}>
        Competencias {anioTemporada}
      </h2>
    </div>
    <div class="grid gap-4 lg:grid-cols-12">
      {
        primera && (
          <article class="card-vigor relative flex flex-col justify-between gap-5 overflow-hidden border-t-2 border-t-orange-500 p-6 lg:col-span-5">
            <img src="/images/jugadores/jugador-rowing.webp" alt="" aria-hidden="true" loading="lazy" class="pointer-events-none absolute -right-6 bottom-0 h-[92%] w-auto max-w-none opacity-25" />
            <div class="relative">
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-orange-500 px-2.5 py-0.5 text-[0.7rem] font-black uppercase tracking-wider text-ink">Primera</span>
                <span class="text-xs font-bold uppercase tracking-wider text-paper/70">{estadoTxt(primera.estado)}</span>
              </div>
              <h3 class="m-0 mt-3 text-2xl font-black uppercase leading-none tracking-tight text-paper sm:text-3xl">{primera.nombre}</h3>
              <p class="m-0 mt-2 max-w-[30ch] text-sm font-medium text-paper/75">La máxima categoría de la liga: fixture, resultados y tabla al día.</p>
            </div>
            <div class="relative flex gap-2">
              <a href={`/fixture?torneo=${primera.id}`} class={btnComp}>Fixture</a>
              <a href={`/tabla?torneo=${primera.id}`} class={btnComp}>Tabla</a>
            </div>
          </article>
        )
      }
      {
        formativas.length > 0 && (
          <article class="card-vigor flex flex-col gap-4 border-t-2 border-t-gold-400 p-4 sm:p-6 lg:col-span-7">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-gold-400 px-2.5 py-0.5 text-[0.7rem] font-black uppercase tracking-wider text-ink">Formativas</span>
                <span class="text-xs font-bold uppercase tracking-wider text-paper/70">{formativas.length} categorías</span>
              </div>
              <span class="text-xs font-semibold text-paper/60">De U10 a U22 · la base de la liga</span>
            </div>
            <ul class="m-0 grid list-none grid-cols-2 gap-2 p-0 sm:grid-cols-3">
              {
                formativas.map((t) => (
                  <li class="flex flex-col justify-between gap-2 border border-navy-700/80 bg-navy-950/60 p-2.5 sm:p-3">
                    <div class="flex items-center justify-between gap-1">
                      <strong class="num text-lg font-black tracking-tight text-paper sm:text-xl">{t.categorias?.nombre}</strong>
                      <span class="rounded bg-navy-900 border border-navy-800 px-1.5 py-0.5 text-[0.58rem] sm:text-[0.65rem] font-bold uppercase tracking-wider text-paper/55">{estadoTxt(t.estado)}</span>
                    </div>
                    <div class="grid grid-cols-2 gap-1 sm:gap-1.5">
                      <a href={`/fixture?torneo=${t.id}`} class="rounded-full border border-navy-700 bg-navy-900/80 py-1 text-center text-[0.62rem] sm:text-[0.68rem] font-black uppercase tracking-tight text-paper/85 no-underline transition-all hover:border-gold-400 hover:bg-gold-400 hover:text-ink">Fixture</a>
                      <a href={`/tabla?torneo=${t.id}`} class="rounded-full border border-navy-700 bg-navy-900/80 py-1 text-center text-[0.62rem] sm:text-[0.68rem] font-black uppercase tracking-tight text-paper/85 no-underline transition-all hover:border-gold-400 hover:bg-gold-400 hover:text-ink">Tabla</a>
                    </div>
                  </li>
                ))
              }
            </ul>
          </article>
        )
      }
    </div>
  </section>

  {
    paginas.length > 0 && (
      <section class="pb-10" aria-labelledby="t-institucional">
        <div class={cabeceraNoticias}>
          <h2 id="t-institucional" class={h2seccion}>
            Institucional
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            paginas.map((p) => (
              <a href={`/${p.slug}`} class="card-vigor p-5 sm:p-6 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-orange-500/50">
                <h3 class="m-0 mb-1.5 text-lg font-black text-paper">{p.titulo}</h3>
                <p class="m-0 text-sm font-medium text-paper/80 leading-relaxed">{p.slug === 'reglamento' ? 'Formato del torneo, sistema de puntos y disciplina.' : 'Oficina, horarios y redes de la liga.'}</p>
              </a>
            ))
          }
        </div>
      </section>
    )
  }

  {
    eventosLd.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(eventosLd)} />
    )
  }
</Base>
  