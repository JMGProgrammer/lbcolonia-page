---
// Noticia individual: cuerpo_md renderizado con mini-markdown servidor (sin dependencias).
import Base from '../../layouts/Base.astro';
import Rotulo from '../../components/Rotulo.astro';
import { noticiaPorSlug } from '../../lib/data';
import { escHtml, fechaLarga, renderMarkdown } from '../../lib/fmt';

const { slug } = Astro.params;
const noticia = slug ? await noticiaPorSlug(slug) : null;
if (!noticia) Astro.response.status = 404;

const fecha = noticia ? (noticia.publicado_at ?? noticia.created_at) : null;
let portada = noticia?.portada_url ?? null;
if (portada && portada.includes('/storage/v1/object/') && !portada.includes('?')) {
  portada = `${portada}?width=1536&quality=80&format=webp`;
}
const fechaIso = fecha ? new Date(fecha).toISOString() : undefined;
const jsonLd =
  fecha && noticia
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'NewsArticle',
          headline: noticia.titulo,
          datePublished: fechaIso,
          author: { '@context': 'https://schema.org', '@type': 'Organization', name: 'Liga de Básquetbol de Colonia' },
          publisher: { '@context': 'https://schema.org', '@type': 'Organization', name: 'Liga de Básquetbol de Colonia' },
          description: noticia.bajada ?? undefined,
        },
      ]
    : [];
---

<Base
  title={noticia ? noticia.titulo : 'Noticia no encontrada'}
  description={noticia ? noticia.bajada ?? noticia.titulo : 'Noticia de la LBC.'}
  jsonLd={jsonLd}
>
  {
    !noticia ? (
      <section class="py-20 text-center">
        <h1 class="text-2xl font-extrabold">Noticia no encontrada</h1>
        <p class="mt-2 text-paper-muted">Quizá la noticia se retiró o nunca se publicó.</p>
        <a href="/noticias" class="mt-6 inline-block rounded-full bg-orange-500 px-6 py-2.5 text-[0.9rem] font-extrabold text-ink no-underline hover:bg-orange-700">
          Ver todas las noticias
        </a>
      </section>
    ) : (
      <article class="py-8 lg:max-w-[860px]">
        <a href="/noticias" class="text-[0.8rem] font-bold text-orange-500 no-underline hover:underline">
          ← Noticias
        </a>
        <div class="mt-4">
          <Rotulo>
            {fecha ? fechaLarga(fecha) : ''}
            {noticia.etiquetas.length > 0 && ` · ${noticia.etiquetas.join(' · ')}`}
          </Rotulo>
        </div>
        <h1 class="text-[1.7rem] font-black leading-tight lg:text-4xl">{noticia.titulo}</h1>
        {noticia.bajada && <p class="mt-3 text-[1.05rem] leading-relaxed text-paper-muted">{noticia.bajada}</p>}

        {
          portada && (
            <img src={portada} alt={`Portada: ${noticia.titulo}`} class="mt-6 w-full rounded-panel border border-navy-700" loading="lazy" width="1536" height="864" />
          )
        }

        {
          noticia.cuerpo_md ? (
            <div class="mt-6" set:html={renderMarkdown(noticia.cuerpo_md)} />
          ) : (
            <p class="mt-6 text-paper-muted">El cuerpo de esta noticia está por publicarse.</p>
          )
        }

        <p class="mt-10 border-t border-navy-700 pt-4 text-[0.8rem] text-paper-muted">
          {escHtml('Fuente: Liga de Básquetbol de Colonia')}
        </p>
      </article>
    )
  }
</Base>
