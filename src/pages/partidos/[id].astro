---
// Ficha pública de partido: agenda + resultado (+ cuartos) + stats por jugador.
// Stats solo cuando la planilla está verificada y el partido publicado (v_detalle_publico).
import Base from '../../layouts/Base.astro';
import Rotulo from '../../components/Rotulo.astro';
import Escudo from '../../components/Escudo.astro';
import { partidoPorId, detallePartido } from '../../lib/data';
import type { EstadisticaPublica } from '../../lib/data';
import { etiquetaEstado, fechaCorta, fechaLarga, horaCorta, rondaLabel } from '../../lib/fmt';

const { id } = Astro.params;
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

let partido = null;
let stats: EstadisticaPublica[] = [];
let hayPartido = false;
if (id && UUID_RE.test(id)) {
  partido = await partidoPorId(id);
  if (partido) {
    stats = partido.publicado ? await detallePartido(id) : [];
    hayPartido = true;
  }
}
if (!hayPartido) Astro.response.status = 404;

const torneo = partido?.torneos;
const loc = partido?.local;
const vis = partido?.visitante;
const esResultado = Boolean(partido && partido.publicado && (partido.estado === 'finalizado' || partido.estado === 'walkover'));
const badge = partido ? etiquetaEstado(partido.estado) : null;
const tonoBadge: Record<string, string> = {
  gris: 'bg-navy-700 text-paper',
  naranja: 'bg-orange-500 text-ink',
  rojo: 'bg-red-500 text-paper',
  dorado: 'bg-gold-400 text-ink',
};
const ganador =
  partido?.puntos_local != null && partido?.puntos_visitante != null
    ? partido.puntos_local === partido.puntos_visitante
      ? null
      : partido.puntos_local > partido.puntos_visitante
        ? loc?.id
        : vis?.id
    : partido?.walkover_ganador_id ?? null;

/* stats agrupadas por equipo (local/visitante) */
const statsLoc = stats.filter((s) => s.equipo_id === loc?.id);
const statsVis = stats.filter((s) => s.equipo_id === vis?.id);

const jsonLd = hayPartido && loc && vis
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'SportsEvent',
        name: `${loc.clubes.nombre} vs ${vis.clubes.nombre}`,
        startDate: partido!.fecha_hora,
        sport: 'basketball',
        location: { '@type': 'Place', name: partido!.sede ?? 'Sede a confirmar' },
        competitor: [
          { '@type': 'SportsTeam', name: loc.clubes.nombre },
          { '@type': 'SportsTeam', name: vis.clubes.nombre },
        ],
        ...(partido!.puntos_local != null && partido!.puntos_visitante != null
          ? { winner: { '@type': 'SportsTeam', name: (partido!.puntos_local ?? 0) > (partido!.puntos_visitante ?? 0) ? loc.clubes.nombre : vis.clubes.nombre } }
          : {}),
      },
    ]
  : [];

const rotuloFicha = partido
  ? torneo
    ? `${torneo.nombre} · ${rondaLabel(partido.ronda)} · ${fechaLarga(partido.fecha_hora)} · ${horaCorta(partido.fecha_hora)}`
    : `${fechaLarga(partido.fecha_hora)} · ${horaCorta(partido.fecha_hora)}`
  : '';
const tituloFicha = hayPartido ? `${loc?.clubes.nombre ?? ''} vs ${vis?.clubes.nombre ?? ''}` : 'Partido';
const descFicha = hayPartido
  ? `${tituloFicha} — ${torneo?.nombre ?? ''} ${rondaLabel(partido!.ronda)}. ${partido!.sede ?? 'Sede a confirmar'}.`
  : 'Ficha de partido de la Liga de Básquetbol de Colonia.';
---

<Base title={tituloFicha} description={descFicha} jsonLd={jsonLd}>
  {
    !hayPartido ? (
      <section class="py-20 text-center">
        <h1 class="text-2xl font-extrabold">Partido no encontrado</h1>
        <p class="mt-2 text-paper-muted">No existe ese partido en las competencias activas, o la liga todavía no lo publicó.</p>
        <a href="/fixture" class="mt-6 inline-block rounded-full bg-orange-500 px-6 py-2.5 text-[0.9rem] font-extrabold text-ink no-underline hover:bg-orange-700">
          Ir al fixture
        </a>
      </section>
    ) : (
      <section class="py-8">
        <a href={`/fixture?torneo=${torneo?.id ?? ''}`} class="mb-4 inline-block text-[0.8rem] font-bold tracking-[0.05em] text-orange-500 no-underline hover:underline">
          ← {torneo?.nombre ?? 'Fixture'}
        </a>
        <Rotulo>{rotuloFicha}</Rotulo>

        <div class="grid gap-4 md:grid-cols-[1fr_0.8fr_1fr] md:items-center">
          <div class="rounded-panel border border-navy-700 bg-navy-800 p-6">
            <div class="flex items-center gap-4">
              <Escudo club={loc?.clubes} tam="lg" />
              <div class="min-w-0">
                <p class={`text-lg font-extrabold ${ganador === loc?.id ? 'text-gold-400' : ''}`}>{loc?.clubes.nombre}</p>
                {loc?.nombre_mostrar && loc.nombre_mostrar !== loc.clubes.nombre && <p class="text-[0.78rem] text-paper-muted">{loc.nombre_mostrar}</p>}
              </div>
            </div>
          </div>
          <div class="rounded-panel border border-navy-700 bg-navy-800 p-6 text-center">
            <span class="num block text-[2.6rem] font-black leading-none text-orange-500 lg:text-[3.2rem]">
              {esResultado ? (partido!.estado === 'walkover' ? 'W' : `${partido!.puntos_local}–${partido!.puntos_visitante}`) : horaCorta(partido!.fecha_hora)}
            </span>
            <span class={`mt-2 inline-block rounded-full px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.14em] ${tonoBadge[badge!.tono]}`}>{badge!.texto}</span>
            {partido!.sede && <p class="mt-3 text-[0.8rem] text-paper-muted">{partido!.sede}</p>}
          </div>
          <div class="rounded-panel border border-navy-700 bg-navy-800 p-6">
            <div class="flex items-center gap-4 md:flex-row-reverse">
              <Escudo club={vis?.clubes} tam="lg" />
              <div class="min-w-0 text-right md:text-left">
                <p class={`text-lg font-extrabold ${ganador === vis?.id ? 'text-gold-400' : ''}`}>{vis?.clubes.nombre}</p>
                {vis?.nombre_mostrar && vis.nombre_mostrar !== vis.clubes.nombre && <p class="text-[0.78rem] text-paper-muted">{vis.nombre_mostrar}</p>}
              </div>
            </div>
          </div>
        </div>

        {
          (partido!.cuartos_local?.length ?? 0) > 0 && (partido!.cuartos_visitante?.length ?? 0) > 0 && (
            <div class="mt-4 overflow-x-auto rounded-panel border border-navy-700 bg-navy-800 p-4">
              <table class="num w-full min-w-[380px] border-collapse text-center">
                <thead>
                  <tr>
                    <th class="px-2 py-1.5 text-[0.62rem] uppercase tracking-[0.14em] text-paper-muted">Equipo</th>
                    {partido!.cuartos_local!.map((_, i) => (
                      <th scope="col" class="px-2 py-1.5 text-[0.62rem] uppercase tracking-[0.14em] text-paper-muted">Q{i + 1}</th>
                    ))}
                    <th scope="col" class="px-2 py-1.5 text-[0.62rem] uppercase tracking-[0.14em] text-paper-muted">Total</th>
                  </tr>
                </thead>
                <tbody>
                  {[
                    ['Local', partido!.cuartos_local!, loc?.clubes.nombre],
                    ['Visita', partido!.cuartos_visitante!, vis?.clubes.nombre],
                  ].map(([etiqueta, cuartos, nombre]) => (
                    <tr class="border-t border-navy-700">
                      <td class="px-2 py-1.5 text-left text-[0.88rem] font-bold">{nombre}</td>
                      {(cuartos as number[]).map((c) => (
                        <td class="px-2 py-1.5 text-right">{c}</td>
                      ))}
                      <td class="px-2 py-1.5 text-right font-black text-orange-500">{(cuartos as number[]).reduce((a, b) => a + b, 0)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        {partido!.nota_publica && (
          <p class="mt-4 rounded-panel border border-gold-400/40 bg-navy-800 p-4 text-center text-sm text-gold-400">{partido!.nota_publica}</p>
        )}

        {
          stats.length > 0 && (
            <div class="mt-10 grid gap-6 lg:grid-cols-2">
              {
                [
                  { titulo: loc?.clubes.nombre ?? 'Local', filas: statsLoc },
                  { titulo: vis?.clubes.nombre ?? 'Visitante', filas: statsVis },
                ].filter((bloque) => bloque.filas.length > 0).map((bloque) => (
                  <div class="overflow-hidden rounded-panel border border-navy-700">
                    <p class="bg-orange-500 px-4 py-2.5 text-[0.72rem] font-extrabold uppercase tracking-[0.14em] text-ink">{bloque.titulo}</p>
                    <div class="overflow-x-auto">
                      <table class="num min-w-[460px] w-full border-collapse bg-navy-800">
                        <thead>
                          <tr>
                            {['#', 'Jugador', 'PTS', 'REB', 'AS', 'RO', 'TA', 'FR'].map((h, i) => (
                              <th scope="col" class={`bg-navy-700 px-2.5 py-2 text-[0.65rem] uppercase tracking-[0.1em] text-paper ${i < 2 ? 'text-left' : 'text-right'}`}>{h}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {bloque.filas.map((s) => (
                            <tr class="border-t border-navy-700">
                              <td class="num px-2.5 py-2 text-paper-muted">{s.dorsal ?? '—'}</td>
                              <td class="px-2.5 py-2 text-[0.9rem] font-bold">{s.nombre_completo}</td>
                              <td class="num px-2.5 py-2 text-right font-black text-orange-500">{s.puntos}</td>
                              <td class="num px-2.5 py-2 text-right">{s.rebotes ?? 0}</td>
                              <td class="num px-2.5 py-2 text-right">{s.asistencias ?? 0}</td>
                              <td class="num px-2.5 py-2 text-right">{s.robos ?? 0}</td>
                              <td class="num px-2.5 py-2 text-right">{s.tapas ?? 0}</td>
                              <td class="num px-2.5 py-2 text-right">{s.faltas}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                ))
              }
            </div>
          )
        }

        {
          stats.length === 0 && esResultado === false && (
            <p class="mt-10 text-center text-sm text-paper-muted">
              Las estadísticas por jugador aparecen cuando la planilla está verificada y la liga publica el partido.
            </p>
          )
        }
      </section>
    )
  }
</Base>
