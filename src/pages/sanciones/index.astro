---
// Sanciones activas del público (v_sanciones_activas: solo cobra lo publicado).
import Base from '../../layouts/Base.astro';
import { sancionesActivas } from '../../lib/data';
import { fechaLarga } from '../../lib/fmt';

const filas = await sancionesActivas();
const tonoTipo: Record<string, string> = {
  jugador: 'bg-navy-700 text-paper',
  tecnico: 'bg-orange-500 text-ink',
  club: 'bg-red-500 text-paper',
};
const textoTipo: Record<string, string> = { jugador: 'Jugador', tecnico: 'Técnico', club: 'Club' };
---

<Base
  title="Sanciones"
  description="Sanciones activas de la Liga de Básquetbol de Colonia: jugadores, técnicos y clubes con fechas por cumplir."
>
  <section class="py-8">
    <h1 class="text-2xl font-black lg:text-3xl">Sanciones activas</h1>
    <p class="mt-1 text-sm text-paper-muted">
      La lista refleja lo sancionado por la liga y se actualiza con cada fecha publicada. El conteo baja cuando el jugador cumple fecha en partidos oficiales.
    </p>
    {
      filas.length === 0 ? (
        <p class="mt-8 rounded-panel border border-navy-700 bg-navy-800 p-8 text-center text-paper-muted">No hay sanciones activas a la fecha.</p>
      ) : (
        <div class="mt-8 grid gap-4">
          {filas.map((s) => (
            <article class="flex flex-col gap-3 rounded-panel border border-navy-700 bg-navy-800 p-5 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <p class="text-[1.05rem] font-extrabold">{s.persona ?? '—'}</p>
                <p class="mt-0.5 text-[0.85rem] text-paper-muted">
                  {s.club ?? 'Sin club'} · desde {s.fecha_alta ? fechaLarga(s.fecha_alta) : '—'}
                </p>
                {s.motivo && <p class="mt-1.5 text-[0.88rem]">{s.motivo}</p>}
              </div>
              <div class="flex items-center gap-3 self-start sm:self-center">
                <span class={`rounded-full px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.12em] ${tonoTipo[s.tipo ?? ''] ?? tonoTipo.jugador}`}>
                  {textoTipo[s.tipo ?? ''] ?? 'Sanción'}
                </span>
                <span class="flex items-baseline gap-1.5 rounded-lg bg-navy-900 px-3 py-2" title="Fechas por cumplir">
                  <span class="num text-2xl font-black text-orange-500">{s.partidos_restantes ?? 0}</span>
                  <span class="text-[0.68rem] uppercase tracking-[0.12em] text-paper-muted">fechas</span>
                </span>
              </div>
            </article>
          ))
        }
        </div>
      )
    }
  </section>
</Base>
